From a73cf2af75e2400569b8c1bf18b825b5e20cb1fc Mon Sep 17 00:00:00 2001
From: Kulesha Evgeniy <voovdop@gmail.com>
Date: Fri, 20 Nov 2026 16:58:55 +0200
Subject: [PATCH 28/29] turnip/a5xx: expand indexed draws on the CPU

a5xx CP_DRAW_INDX_OFFSET(DMA) does not fetch indices in our sysmem/bypass
render mode, so indexed draws produced nothing (vkcube was a black
window). Remember the bound index/vertex buffers, build a temporary
vertex buffer with vertices in index order, and emit a regular
non-indexed draw. Covers one-instance triangle-list content such as
vkcube; falls back to the old path when unsupported.
---
 src/freedreno/vulkan/tu5_graphics.cc  | 135 ++++++++++++++++++++++++++
 src/freedreno/vulkan/tu5_graphics.h   |   1 +
 src/freedreno/vulkan/tu_cmd_buffer.cc |   5 +-
 src/freedreno/vulkan/tu_cmd_buffer.h  |   4 +
 4 files changed, 144 insertions(+), 1 deletion(-)

diff --git a/src/freedreno/vulkan/tu5_graphics.cc b/src/freedreno/vulkan/tu5_graphics.cc
index 7c138d0..91cb078 100644
--- a/src/freedreno/vulkan/tu5_graphics.cc
+++ b/src/freedreno/vulkan/tu5_graphics.cc
@@ -18,7 +18,9 @@
 #include <stdlib.h>
 #include <string.h>
 
+#include "tu_buffer.h"
 #include "tu_cmd_buffer.h"
+#include "tu_knl.h"
 #include "tu_image.h"
 #include "tu_sampler.h"
 #include "tu_shader.h"
@@ -2152,3 +2154,136 @@ tu5_draw(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info)
    if (getenv("TU5_GFX_DUMPCS"))
       tu5_dump_cs(cmd);
 }
+
+/* a5xx hardware index fetch through CP_DRAW_INDX_OFFSET(DMA) does not work in
+ * our sysmem/bypass path. Expand the indexed draw on the CPU: build a small
+ * temporary vertex buffer with vertices in index order and issue a regular
+ * non-indexed draw. This is enough for triangle-list style content (vkcube).
+ */
+
+void
+tu5_draw_indexed(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info)
+{
+   struct tu5_draw_info local = *info;
+   info = &local;
+
+   if (!info->indexed || !cmd->state.index_buffer || info->instance_count != 1) {
+      tu5_draw(cmd, info);
+      return;
+   }
+
+   struct tu_buffer *ibuf = cmd->state.index_buffer;
+   if (tu_bo_map(cmd->device, ibuf->bo, NULL) != VK_SUCCESS) {
+      tu5_draw(cmd, info);
+      return;
+   }
+
+   unsigned index_bytes;
+   switch (cmd->state.index_size) {
+   case INDEX4_SIZE_8_BIT:
+      index_bytes = 1;
+      break;
+   case INDEX4_SIZE_16_BIT:
+      index_bytes = 2;
+      break;
+   case INDEX4_SIZE_32_BIT:
+      index_bytes = 4;
+      break;
+   default:
+      tu5_draw(cmd, info);
+      return;
+   }
+
+   if (cmd->state.index_va < ibuf->bo->iova ||
+       cmd->state.index_va - ibuf->bo->iova >= ibuf->bo->size) {
+      tu5_draw(cmd, info);
+      return;
+   }
+
+   const uint8_t *idx = (const uint8_t *)ibuf->bo->map +
+      (cmd->state.index_va - ibuf->bo->iova) +
+      (size_t)info->first_index * index_bytes;
+
+   struct tu_cs_memory tmp[MAX_VBS] = {};
+   bool any = false;
+
+   for (unsigned b = 0; b < cmd->state.max_vbs_bound; b++) {
+      struct tu_buffer *vb = cmd->state.vb_buffer[b];
+      if (!vb || !cmd->state.vb[b].size)
+         continue;
+
+      unsigned stride = cmd->state.vi.bindings[b].stride;
+      if (!stride)
+         continue;
+
+      if (tu_bo_map(cmd->device, vb->bo, NULL) != VK_SUCCESS) {
+         tu5_draw(cmd, info);
+         return;
+      }
+
+      uint64_t size = (uint64_t)info->index_count * stride;
+      if (!size || size > 4 * 1024 * 1024) {
+         tu5_draw(cmd, info);
+         return;
+      }
+
+      if (tu_cs_alloc(&cmd->sub_cs, size, 16, &tmp[b]) != VK_SUCCESS) {
+         tu5_draw(cmd, info);
+         return;
+      }
+
+      uint64_t vb_off = cmd->state.vb[b].base - vb->bo->iova;
+      const uint8_t *src = (const uint8_t *)vb->bo->map + vb_off;
+
+      for (unsigned i = 0; i < info->index_count; i++) {
+         uint32_t index;
+         if (index_bytes == 1)
+            index = idx[i];
+         else if (index_bytes == 2)
+            index = ((const uint16_t *)idx)[i];
+         else
+            index = ((const uint32_t *)idx)[i];
+
+         index += info->vertex_offset;
+         if ((uint64_t)index * stride + stride > cmd->state.vb[b].size)
+            continue;
+
+         memcpy((uint8_t *)tmp[b].map + (uint64_t)i * stride,
+                src + (uint64_t)index * stride, stride);
+      }
+
+      any = true;
+   }
+
+   if (!any) {
+      tu5_draw(cmd, info);
+      return;
+   }
+
+   uint64_t old_base[MAX_VBS] = {};
+   uint32_t old_size[MAX_VBS] = {};
+
+   for (unsigned b = 0; b < cmd->state.max_vbs_bound; b++) {
+      if (!tmp[b].map)
+         continue;
+      old_base[b] = cmd->state.vb[b].base;
+      old_size[b] = cmd->state.vb[b].size;
+      cmd->state.vb[b].base = tmp[b].iova;
+      cmd->state.vb[b].size =
+         (uint64_t)info->index_count * cmd->state.vi.bindings[b].stride;
+   }
+
+   struct tu5_draw_info nonindexed = *info;
+   nonindexed.indexed = false;
+   nonindexed.vertex_count = info->index_count;
+   nonindexed.first_vertex = 0;
+   nonindexed.vertex_offset = 0;
+   tu5_draw(cmd, &nonindexed);
+
+   for (unsigned b = 0; b < cmd->state.max_vbs_bound; b++) {
+      if (!tmp[b].map)
+         continue;
+      cmd->state.vb[b].base = old_base[b];
+      cmd->state.vb[b].size = old_size[b];
+   }
+}
diff --git a/src/freedreno/vulkan/tu5_graphics.h b/src/freedreno/vulkan/tu5_graphics.h
index e1bb992..7b89d94 100644
--- a/src/freedreno/vulkan/tu5_graphics.h
+++ b/src/freedreno/vulkan/tu5_graphics.h
@@ -26,6 +26,7 @@ struct tu5_draw_info {
 };
 
 void tu5_draw(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info);
+void tu5_draw_indexed(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info);
 
 /* Apply the render-pass loadOp=CLEAR for color attachments. a5xx sysmem
  * rendering has no GMEM, so this is done with a linear memory fill.
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index d83db1b..4dca8ac 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -4705,10 +4705,12 @@ tu_CmdBindVertexBuffers2(VkCommandBuffer commandBuffer,
 
    for (uint32_t i = 0; i < bindingCount; i++) {
       if (pBuffers[i] == VK_NULL_HANDLE) {
+         cmd->state.vb_buffer[firstBinding + i] = NULL;
          cmd->state.vb[firstBinding + i].base = 0;
          cmd->state.vb[firstBinding + i].size = 0;
       } else {
          struct tu_buffer *buf = tu_buffer_from_handle(pBuffers[i]);
+         cmd->state.vb_buffer[firstBinding + i] = buf;
          cmd->state.vb[firstBinding + i].base = vk_buffer_address(&buf->vk, pOffsets[i]);
          cmd->state.vb[firstBinding + i].size =
             vk_buffer_range(&buf->vk, pOffsets[i], pSizes ? pSizes[i] : VK_WHOLE_SIZE);
@@ -4765,6 +4767,7 @@ tu_CmdBindIndexBuffer2KHR(VkCommandBuffer commandBuffer,
     */
    vk_cmd_set_index_buffer_type(&cmd->vk, indexType);
 
+   cmd->state.index_buffer = buf;
    if (buf) {
       cmd->state.index_va = vk_buffer_address(&buf->vk, offset);
       cmd->state.max_index_count = size >> index_shift;
@@ -9399,7 +9402,7 @@ tu_CmdDrawIndexed(VkCommandBuffer commandBuffer,
          .first_index = firstIndex,
          .vertex_offset = vertexOffset,
       };
-      tu5_draw(cmd, &info);
+      tu5_draw_indexed(cmd, &info);
       return;
    }
 
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.h b/src/freedreno/vulkan/tu_cmd_buffer.h
index e8b8067..c428089 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.h
+++ b/src/freedreno/vulkan/tu_cmd_buffer.h
@@ -555,6 +555,10 @@ struct tu_cmd_state
    uint32_t max_index_count;
    uint8_t index_size;
 
+   /* a5xx CPU index expansion needs the original buffer objects. */
+   struct tu_buffer *index_buffer;
+   struct tu_buffer *vb_buffer[MAX_VBS];
+
    /* because streamout base has to be 32-byte aligned
     * there is an extra offset to deal with when it is
     * unaligned
