                         physical_device->info, VK_SAMPLE_COUNT_1_BIT, 1,
diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
index 478a63b..568dba9 100644
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -566,6 +566,14 @@ tu_image_init(struct tu_device *device, struct tu_image *image,
       force_linear_tile = true;
    }
 
+   /* The a5xx sysmem path only understands linear images: its MRT/texture
+    * descriptors use TILE5_LINEAR and there is no UBWC support.
+    */
+   if (device->physical_device->info->chip == 5 && !plane_layouts) {
+      force_linear_tile = true;
+      ubwc_enabled = false;
+   }
+
    /* Force linear tiling for HIC usage with swapped formats. Because tiled
     * images are stored without the swap, we would have to apply the swap when
     * copying on the CPU, which for some formats is tricky.
