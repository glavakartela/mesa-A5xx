    struct {
       uint8_t set, binding;
    } ssbo_map[TU5_MAX_SSBOS];
+   uint8_t num_ubos;
+   struct {
+      uint8_t set, binding;
+   } ubo_map[TU5_MAX_UBOS];
 
    /* The dynamic buffer descriptor size for descriptor sets that we know
     * about. This is used when linking to piece together the sizes and from
