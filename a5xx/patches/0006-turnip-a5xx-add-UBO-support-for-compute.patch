       nir->info.num_ubos = 0;
@@ -1572,6 +1575,7 @@ tu5_lower_bindful_ssbo_instr(nir_builder *b, nir_instr *instr, void *data)
    unsigned desc_src;
 
    switch (intrin->intrinsic) {
+   case nir_intrinsic_load_ubo:
    case nir_intrinsic_load_ssbo:
    case nir_intrinsic_ssbo_atomic:
    case nir_intrinsic_ssbo_atomic_swap:
@@ -3582,6 +3586,8 @@ tu_shader_cache_process_blob(IO &io, struct tu_shader *shader)
    io.u8(shader->active_desc_sets);
    io.u8(shader->num_ssbos);
    io.bytes(shader->ssbo_map, sizeof(shader->ssbo_map));
+   io.u8(shader->num_ubos);
+   io.bytes(shader->ubo_map, sizeof(shader->ubo_map));
    io.boolean(shader->per_layer_viewport);
 
    io.variant(shader->variant);
@@ -3884,6 +3890,20 @@ tu_shader_create(struct tu_device *dev,
          nir->info.num_ssbos = max_binding + 1;
    }
 
+   if (dev->physical_device->info->chip == 5) {
+      nir_foreach_variable_with_modes (var, nir, nir_var_mem_ubo) {
+         if (var->data.descriptor_set != 0 ||
+             var->data.binding >= TU5_MAX_UBOS ||
+             shader->num_ubos >= TU5_MAX_UBOS) {
+            vk_free(&dev->vk.alloc, shader);
+            return VK_ERROR_FEATURE_NOT_PRESENT;
+         }
+         shader->ubo_map[shader->num_ubos].set = var->data.descriptor_set;
+         shader->ubo_map[shader->num_ubos].binding = var->data.binding;
+         shader->num_ubos++;
+      }
+   }
+
    if (dev->physical_device->info->chip == 5) {
       /* a5xx isam/ldgb take an immediate SSBO state slot; replace the bindless
        * descriptor vector with that slot before descriptor lowering runs.
diff --git a/src/freedreno/vulkan/tu_shader.h b/src/freedreno/vulkan/tu_shader.h
