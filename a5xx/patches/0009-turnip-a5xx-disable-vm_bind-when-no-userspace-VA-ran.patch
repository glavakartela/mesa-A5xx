From adf78fe9637c302b7130597b0419c3453641842a Mon Sep 17 00:00:00 2001
From: local <local@local>
Date: Thu, 19 Nov 2026 22:37:11 +0200
Subject: [PATCH 09/29] turnip/a5xx: disable vm_bind when no userspace VA range

The whyred mainline kernel advertises vm_bind but not a userspace VA
range, which left device->vma uninitialized and crashed in
util_vma_heap_validate(). Fall back to kernel-assigned IOVAs in that case.

With this, the compute smoke test passes on the current whyred kernel.
---
 src/freedreno/vulkan/tu_knl_drm_msm.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/freedreno/vulkan/tu_knl_drm_msm.cc b/src/freedreno/vulkan/tu_knl_drm_msm.cc
index 0f4404b..ea6d3ae 100644
--- a/src/freedreno/vulkan/tu_knl_drm_msm.cc
+++ b/src/freedreno/vulkan/tu_knl_drm_msm.cc
@@ -1405,6 +1405,11 @@ tu_knl_drm_msm_load(struct tu_instance *instance,
       device->va_start = 0;
       device->va_size = 0;
    }
+   /* vm_bind without a userspace VA range still needs a VMA heap in Turnip. */
+   if (!device->has_set_iova) {
+      device->has_vm_bind = false;
+      device->has_sparse = false;
+   }
    device->has_iova_align = device->has_set_iova;
    device->has_lazy_bos = device->has_set_iova;
    device->has_raytracing = tu_drm_get_param_or(fd, MSM_PARAM_RAYTRACING, &val, false);
