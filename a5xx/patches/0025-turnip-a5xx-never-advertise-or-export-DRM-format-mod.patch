From 1709362d3719df9945ab88995caa472a75a277ed Mon Sep 17 00:00:00 2001
From: Kulesha Evgeniy <voovdop@gmail.com>
Date: Fri, 20 Nov 2026 16:19:26 +0200
Subject: [PATCH 25/29] turnip/a5xx: never advertise or export DRM format
 modifiers

a5xx only supports linear color images, but WSI had supports_modifiers=true
and image creation could select QCOM_COMPRESSED. That exported a buffer
with a compressed modifier while the actual layout was forced linear,
which can hang the display/GPU when the compositor imports it.

- disable WSI modifiers on chip 5
- never pick QCOM_COMPRESSED for chip 5 image modifier lists, reject
  explicit QCOM_COMPRESSED
- always export LINEAR modifier for chip 5
---
 src/freedreno/vulkan/tu_device.cc | 4 +++-
 src/freedreno/vulkan/tu_image.cc  | 6 +++++-
 src/freedreno/vulkan/tu_wsi.cc    | 6 +++++-
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/vulkan/tu_device.cc b/src/freedreno/vulkan/tu_device.cc
index 83f440f..70c0bbd 100644
--- a/src/freedreno/vulkan/tu_device.cc
+++ b/src/freedreno/vulkan/tu_device.cc
@@ -4564,7 +4564,9 @@ tu_GetMemoryFdKHR(VkDevice _device,
    if (memory->image) {
       struct fdl_layout *l = &memory->image->layout[0];
       uint64_t modifier;
-      if (l->ubwc) {
+      if (device->physical_device->info->chip == 5) {
+         modifier = DRM_FORMAT_MOD_LINEAR;
+      } else if (l->ubwc) {
          modifier = DRM_FORMAT_MOD_QCOM_COMPRESSED;
       } else if (l->tile_mode == 2) {
          modifier = DRM_FORMAT_MOD_QCOM_TILED2;
diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
index 198984d..9442024 100644
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -996,11 +996,15 @@ tu_CreateImage(VkDevice _device,
          modifier = DRM_FORMAT_MOD_LINEAR;
          for (unsigned i = 0; i < mod_info->drmFormatModifierCount; i++) {
             if (mod_info->pDrmFormatModifiers[i] == DRM_FORMAT_MOD_QCOM_COMPRESSED &&
-                !compression_disabled)
+                !compression_disabled &&
+                device->physical_device->info->chip != 5)
                modifier = DRM_FORMAT_MOD_QCOM_COMPRESSED;
          }
       } else {
          modifier = drm_explicit_info->drmFormatModifier;
+         if (device->physical_device->info->chip == 5 &&
+             modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED)
+            return vk_error(device, VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT);
          assert(modifier == DRM_FORMAT_MOD_LINEAR ||
                 modifier == DRM_FORMAT_MOD_QCOM_COMPRESSED);
          assert(modifier != DRM_FORMAT_MOD_QCOM_COMPRESSED ||
diff --git a/src/freedreno/vulkan/tu_wsi.cc b/src/freedreno/vulkan/tu_wsi.cc
index 4db6d5e..19310ed 100644
--- a/src/freedreno/vulkan/tu_wsi.cc
+++ b/src/freedreno/vulkan/tu_wsi.cc
@@ -49,7 +49,11 @@ tu_wsi_init(struct tu_physical_device *physical_device)
    if (result != VK_SUCCESS)
       return result;
 
-   physical_device->wsi_device.supports_modifiers = true;
+   /* a5xx only supports linear color images; advertising DRM format
+    * modifiers would make the Wayland WSI pick QCOM_COMPRESSED and export a
+    * buffer whose layout does not match the modifier. */
+   physical_device->wsi_device.supports_modifiers =
+      physical_device->info->chip != 5;
    physical_device->wsi_device.can_present_on_device =
       tu_wsi_can_present_on_device;
 
