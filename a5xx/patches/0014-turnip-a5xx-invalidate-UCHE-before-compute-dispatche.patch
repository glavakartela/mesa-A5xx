From 66125eeaab9493d12709d3ef75d3fb06dff0ce93 Mon Sep 17 00:00:00 2001
From: opencode <user@example.com>
Date: Fri, 20 Nov 2026 10:04:48 +0200
Subject: [PATCH 14/29] turnip/a5xx: invalidate UCHE before compute dispatches

UCHE is physically indexed and survives process switches; buffers of
different processes can alias in physical memory. Without the
invalidate a new process could execute the previous process' shader or
read its descriptors, which showed up as a GPU hang in tu5_array_test
when it ran right after tu5_ubo_test.

tu5_ubo_test <-> tu5_array_test, four runs in a row: all PASS 512/512.
---
 src/freedreno/vulkan/tu5_compute.cc | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/freedreno/vulkan/tu5_compute.cc b/src/freedreno/vulkan/tu5_compute.cc
index 0d3df43..811208a 100644
--- a/src/freedreno/vulkan/tu5_compute.cc
+++ b/src/freedreno/vulkan/tu5_compute.cc
@@ -25,6 +25,7 @@
 
 #include "ir3/ir3_shader.h"
 #include "tu5_regs.h"
+#include "tu5_gfx_regs.h"
 
 /* Compact storage-buffer descriptor written by
  * write_buffer_descriptor_addr() when info->chip == 5:
@@ -408,6 +409,18 @@ tu5_dispatch(struct tu_cmd_buffer *cmd, const struct tu_dispatch_info *info)
 
    const struct ir3_shader_variant *v = shader->variant;
 
+   /* UCHE is physically indexed and survives process switches; BOs of
+    * different processes can alias in physical memory. Invalidate it before
+    * the dispatch so we never read stale shader/descriptor data.
+    */
+   tu_cs_emit_pkt4(&cmd->cs, REG_A5XX_UCHE_CACHE_INVALIDATE_MIN, 5);
+   tu_cs_emit(&cmd->cs, 0);
+   tu_cs_emit(&cmd->cs, 0);
+   tu_cs_emit(&cmd->cs, 0);
+   tu_cs_emit(&cmd->cs, 0);
+   tu_cs_emit(&cmd->cs, 0x12);
+   tu_cs_emit_pkt7(&cmd->cs, CP_WAIT_FOR_IDLE, 0);
+
    tu5_emit_flush(cmd);
    tu5_emit_driver_params(cmd, v, info);
    tu5_emit_push_consts(cmd, v);
