From 98ea3ad915340d213b10a547a278bbcad7b65f57 Mon Sep 17 00:00:00 2001
From: opencode <user@example.com>
Date: Fri, 20 Nov 2026 14:43:21 +0200
Subject: [PATCH 22/29] turnip/a5xx: WIP texture stability (f16 sam, half regs,
 FOUR_QUADS)

- Lower f32 texture results to f16 and convert back to f32; fd5 uses
  sam (f16) on a5xx and a highp sam (f32) is unreliable.
- Set HALFREGFOOTPRINT to at least 1 and select FOUR_QUADS when the FS
  uses half registers; TWO_QUADS + f16 texture sampling hangs.
- Use fd5's 0.125 sampler max LOD when mipmapping is off.
- HLSQ_CONTROL_2/3/4 carry raw regids: unused sysvals must be 0xfc
  (r63.x), not 0 (=r0).
- Do not preload compute shaders: a preloaded graphics pipeline leaves
  VS/FS code in the shared internal instruction store and a following
  preloaded compute dispatch read zero instead of the SSBO contents.
- Program the full RB_MODE_CNTL and keep texture/IR3 debug dumps.

Status: the texture draw now matches fd5 (sam (f16) + cov.f16f32,
HALFREGFOOTPRINT=1, FOUR_QUADS) and passes on a fresh GPU, but after
other graphics workloads it can return zeros or hang.  Not deployed:
the stable 08e28cf driver (compute + graphics without textures) is used
on the phone.
---
 src/freedreno/vulkan/tu5_compute.cc  | 12 +++++------
 src/freedreno/vulkan/tu5_graphics.cc | 23 ++++++++++++++++-----
 src/freedreno/vulkan/tu_shader.cc    | 30 ++++++++++++++++++++++++++++
 3 files changed, 54 insertions(+), 11 deletions(-)

diff --git a/src/freedreno/vulkan/tu5_compute.cc b/src/freedreno/vulkan/tu5_compute.cc
index 811208a..ddd40eb 100644
--- a/src/freedreno/vulkan/tu5_compute.cc
+++ b/src/freedreno/vulkan/tu5_compute.cc
@@ -44,13 +44,13 @@ tu5_emit_cs_config(struct tu_cs *cs,
    const struct ir3_info *info = &v->info;
    enum tu5_threadsize thrsz =
       info->double_threadsize ? TU5_FOUR_QUADS : TU5_TWO_QUADS;
-   unsigned instrlen = v->instrlen;
-
-   /* If the shader is larger than 32*16 instructions, don't preload it.
-    * Mirrors the Gallium a5xx compute path.
+   /* Do not preload compute shaders into the shared internal instruction
+    * store: a preloaded graphics pipeline leaves its VS/FS there, and a
+    * subsequent preloaded compute dispatch was observed to read 0 instead
+    * of the SSBO values.  External fetch works reliably; keep it.
     */
-   if (instrlen > 32)
-      instrlen = 0;
+   unsigned instrlen = 0;
+   (void)v->instrlen;
 
    tu_cs_emit_pkt4(cs, TU5_REG_SP_SP_CNTL, 1);
    tu_cs_emit(cs, 0);
diff --git a/src/freedreno/vulkan/tu5_graphics.cc b/src/freedreno/vulkan/tu5_graphics.cc
index c4baab8..5809737 100644
--- a/src/freedreno/vulkan/tu5_graphics.cc
+++ b/src/freedreno/vulkan/tu5_graphics.cc
@@ -286,8 +286,12 @@ tu5_emit_program(struct tu_cmd_buffer *cmd,
    s[0].instroff = 0;
    s[1].instroff = 64 - s[1].instrlen;
 
+   /* a5xx requires FOUR_QUADS when the FS uses half registers (for example
+    * an f16 texture sample); TWO_QUADS with half regs hangs the texture unit.
+    */
    enum a3xx_threadsize fssz =
-      s[1].info->double_threadsize ? FOUR_QUADS : TWO_QUADS;
+      (s[1].info->double_threadsize || s[1].info->max_half_reg >= 0) ?
+      FOUR_QUADS : TWO_QUADS;
 
    uint32_t pos_regid = ir3_find_output_regid(vs, VARYING_SLOT_POS);
    uint32_t psize_regid = ir3_find_output_regid(vs, VARYING_SLOT_PSIZ);
@@ -370,7 +374,8 @@ tu5_emit_program(struct tu_cmd_buffer *cmd,
    tu_cs_emit(cs, s[1].instrlen);
 
    tu5_emit_reg(cs, REG_A5XX_SP_VS_CTRL_REG0,
-      A5XX_SP_VS_CTRL_REG0_HALFREGFOOTPRINT(s[0].info->max_half_reg + 1) |
+      A5XX_SP_VS_CTRL_REG0_HALFREGFOOTPRINT(
+         MAX2(s[0].info->max_half_reg + 1, 1)) |
       A5XX_SP_VS_CTRL_REG0_FULLREGFOOTPRINT(s[0].info->max_reg + 1) |
       COND(s[0].instrlen != 0, A5XX_SP_VS_CTRL_REG0_BUFFER) |
       0x2 |
@@ -465,7 +470,8 @@ tu5_emit_program(struct tu_cmd_buffer *cmd,
       0x40002 |
       COND(s[1].instrlen != 0, A5XX_SP_FS_CTRL_REG0_BUFFER) |
       A5XX_SP_FS_CTRL_REG0_THREADSIZE(fssz) |
-      A5XX_SP_FS_CTRL_REG0_HALFREGFOOTPRINT(s[1].info->max_half_reg + 1) |
+      A5XX_SP_FS_CTRL_REG0_HALFREGFOOTPRINT(
+         MAX2(s[1].info->max_half_reg + 1, 1)) |
       A5XX_SP_FS_CTRL_REG0_FULLREGFOOTPRINT(s[1].info->max_reg + 1) |
       A5XX_SP_FS_CTRL_REG0_BRANCHSTACK(ir3_shader_branchstack_hw(fs)) |
       COND(fs->need_pixlod, A5XX_SP_FS_CTRL_REG0_PIXLODENABLE));
@@ -474,7 +480,8 @@ tu5_emit_program(struct tu_cmd_buffer *cmd,
       fprintf(stderr, "  iova vs=%" PRIx64 " fs=%" PRIx64 "\n",
               vs_shader->binary_iova, fs_shader->binary_iova);
       fprintf(stderr, "  vscntl=0x%x fsctrl=0x%x hlsq0=0x%x\n",
-         A5XX_SP_VS_CTRL_REG0_HALFREGFOOTPRINT(s[0].info->max_half_reg + 1) |
+         A5XX_SP_VS_CTRL_REG0_HALFREGFOOTPRINT(
+            MAX2(s[0].info->max_half_reg + 1, 1)) |
          A5XX_SP_VS_CTRL_REG0_FULLREGFOOTPRINT(s[0].info->max_reg + 1) |
          COND(s[0].instrlen != 0, A5XX_SP_VS_CTRL_REG0_BUFFER) | 0x2 |
          A5XX_SP_VS_CTRL_REG0_BRANCHSTACK(ir3_shader_branchstack_hw(vs)) |
@@ -482,7 +489,8 @@ tu5_emit_program(struct tu_cmd_buffer *cmd,
          COND(fs->total_in > 0, A5XX_SP_FS_CTRL_REG0_VARYING) | 0x40002 |
          COND(s[1].instrlen != 0, A5XX_SP_FS_CTRL_REG0_BUFFER) |
          A5XX_SP_FS_CTRL_REG0_THREADSIZE(fssz) |
-         A5XX_SP_FS_CTRL_REG0_HALFREGFOOTPRINT(s[1].info->max_half_reg + 1) |
+         A5XX_SP_FS_CTRL_REG0_HALFREGFOOTPRINT(
+            MAX2(s[1].info->max_half_reg + 1, 1)) |
          A5XX_SP_FS_CTRL_REG0_FULLREGFOOTPRINT(s[1].info->max_reg + 1) |
          A5XX_SP_FS_CTRL_REG0_BRANCHSTACK(ir3_shader_branchstack_hw(fs)) |
          COND(fs->need_pixlod, A5XX_SP_FS_CTRL_REG0_PIXLODENABLE),
@@ -1233,6 +1241,11 @@ tu5_sampler_descriptor(const uint32_t *src, uint32_t *dst)
 {
    dst[0] = src[0];
    dst[1] = src[1] & ~0x1u;
+   /* fd5 uses a small non-zero LOD clamp when mipmapping is off so the HW
+    * can still choose between min and mag filtering of level 0.
+    */
+   if (!(dst[1] & A5XX_TEX_SAMP_1_MAX_LOD__MASK))
+      dst[1] |= A5XX_TEX_SAMP_1_MAX_LOD(0.125f);
    dst[2] = 0;
    dst[3] = 0;
 }
diff --git a/src/freedreno/vulkan/tu_shader.cc b/src/freedreno/vulkan/tu_shader.cc
index 9731e1b..491592c 100644
--- a/src/freedreno/vulkan/tu_shader.cc
+++ b/src/freedreno/vulkan/tu_shader.cc
@@ -1075,6 +1075,31 @@ lower_tex_texel_buffer_to_image(
  * the TPL1 texture/sampler slot and drop the descriptor deref sources. The
  * driver emits TPL1 state for those slots at draw time.
  */
+/* a5xx's texture unit returns half-precision values.  A highp Vulkan
+ * shader would otherwise get a "sam (f32)" instruction, which is unreliable
+ * on this generation (observed as zero samples and GPU hangs).  Force the
+ * texture result to f16 and convert back to f32, matching what fd5 does for
+ * mediump shaders.
+ */
+static bool
+tu5_lower_tex_to_f16(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_tex)
+      return false;
+
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   if (tex->dest_type != nir_type_float32)
+      return false;
+
+   tex->def.bit_size = 16;
+   tex->dest_type = nir_type_float16;
+
+   b->cursor = nir_after_instr(&tex->instr);
+   nir_def *cvt = nir_f2f32(b, &tex->def);
+   nir_def_rewrite_uses_after(&tex->def, cvt);
+   return true;
+}
+
 static bool
 tu5_lower_bindful_tex(nir_tex_instr *tex, struct tu_shader *shader, bool ref)
 {
@@ -4018,6 +4043,11 @@ tu_shader_create(struct tu_device *dev,
             key->read_only_input_attachments, key->dynamic_renderpass,
             &const_allocs);
 
+   if (dev->physical_device->info->chip == 5) {
+      NIR_PASS(_, nir, nir_shader_instructions_pass,
+               tu5_lower_tex_to_f16, nir_metadata_none, NULL);
+   }
+
    if (dev->physical_device->info->chip == 5) {
       uint32_t size_base =
          const_allocs.consts[IR3_CONST_ALLOC_SSBO_SIZES].offset_vec4 * 4;
