+   for (uint32_t i = 0; i < qf_count; i++) {
+      if (qf[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) {
+         queue_family = i;
+         break;
+      }
+   }
+   if (queue_family == UINT32_MAX) {
+      fprintf(stderr, "no graphics queue\n");
+      return 1;
+   }
+
+   float priority = 1.0f;
