+   CHECK(vkMapMemory(device, vb_mem, 0, sizeof(verts), 0, &vb_map));
+   memcpy(vb_map, verts, sizeof(verts));
+   vkUnmapMemory(device, vb_mem);
+
+   static const uint16_t indices[3] = { 0, 1, 2 };
+   VkBufferCreateInfo ib_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = sizeof(indices),
+      .usage = VK_BUFFER_USAGE_INDEX_BUFFER_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkBuffer ibo;
+   CHECK(vkCreateBuffer(device, &ib_info, NULL, &ibo));
+   VkMemoryRequirements ib_req;
+   vkGetBufferMemoryRequirements(device, ibo, &ib_req);
+   VkMemoryAllocateInfo ib_ai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = ib_req.size,
+      .memoryTypeIndex = find_memory_type(phys[0], ib_req.memoryTypeBits,
+         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
+   };
+   VkDeviceMemory ib_mem;
+   CHECK(vkAllocateMemory(device, &ib_ai, NULL, &ib_mem));
+   CHECK(vkBindBufferMemory(device, ibo, ib_mem, 0));
