+#define A5EN_RB5_R5G6B5_UNORM 14
+#define A5EN_RB5_R8G8_UNORM 15
+#define A5EN_RB5_R8G8_SNORM 16
+#define A5EN_RB5_R8G8_UINT 17
+#define A5EN_RB5_R8G8_SINT 18
+#define A5EN_RB5_R16_UNORM 21
+#define A5EN_RB5_R16_SNORM 22
+#define A5EN_RB5_R16_FLOAT 23
+#define A5EN_RB5_R16_UINT 24
+#define A5EN_RB5_R16_SINT 25
+#define A5EN_RB5_R8G8B8A8_UNORM 48
+#define A5EN_RB5_R8G8B8_UNORM 49
+#define A5EN_RB5_R8G8B8A8_SNORM 50
+#define A5EN_RB5_R8G8B8A8_UINT 51
+#define A5EN_RB5_R8G8B8A8_SINT 52
+#define A5EN_RB5_R10G10B10A2_UNORM 55
+#define A5EN_RB5_R10G10B10A2_UINT 58
+#define A5EN_RB5_R11G11B10_FLOAT 66
