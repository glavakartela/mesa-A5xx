+static void
+flush_mem(VkDevice device, VkDeviceMemory mem)
+{
+   VkMappedMemoryRange r = {
+      .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+      .memory = mem,
+      .offset = 0,
+      .size = VK_WHOLE_SIZE,
+   };
+   CHECK(vkFlushMappedMemoryRanges(device, 1, &r));
+}
