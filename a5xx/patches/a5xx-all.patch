--- /dev/null
+++ b/src/freedreno/vulkan/tu5_gfx_regs.h
@@ -0,0 +1,3365 @@
+/* Autogenerated from build a5xx.xml.h. Register/field macros only; enum
+ * declarations are intentionally omitted to avoid clashes with a6xx headers.
+ * Enum constants are available as A5EN_*. */
+#ifndef TU5_GFX_REGS_H
+#define TU5_GFX_REGS_H
+
+#include <stdint.h>
+
+#define A5XX_XML
+#define A5EN_RB5_A8_UNORM 2
+#define A5EN_RB5_R8_UNORM 3
+#define A5EN_RB5_R8_SNORM 4
+#define A5EN_RB5_R8_UINT 5
+#define A5EN_RB5_R8_SINT 6
