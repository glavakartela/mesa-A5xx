+#define A5EN_RB5_R16G16_SNORM 68
+#define A5EN_RB5_R16G16_FLOAT 69
+#define A5EN_RB5_R16G16_UINT 70
+#define A5EN_RB5_R16G16_SINT 71
+#define A5EN_RB5_R32_FLOAT 74
+#define A5EN_RB5_R32_UINT 75
+#define A5EN_RB5_R32_SINT 76
+#define A5EN_RB5_R16G16B16A16_UNORM 96
+#define A5EN_RB5_R16G16B16A16_SNORM 97
