+   vkGetImageSubresourceLayout(device, color_image, &subres, &sub_layout);
+   uint8_t *map;
+   CHECK(vkMapMemory(device, color_mem, 0, VK_WHOLE_SIZE, 0, (void **)&map));
+
+   unsigned red = 0, green = 0, other = 0;
+   for (uint32_t y = 0; y < height; y++) {
+      const uint32_t *row =
+         (const uint32_t *)(map + sub_layout.offset + y * sub_layout.rowPitch);
+      for (uint32_t x = 0; x < width; x++) {
+         if (row[x] == 0xff0000ffu)
+            red++;
+         else if (row[x] == 0xff00ff00u)
+            green++;
+         else
+            other++;
+      }
+   }
+   uint32_t left =
+      *(const uint32_t *)(map + sub_layout.offset + 32 * sub_layout.rowPitch +
+                          16 * 4);
+   uint32_t right =
+      *(const uint32_t *)(map + sub_layout.offset + 32 * sub_layout.rowPitch +
+                          48 * 4);
+   uint32_t top_left =
+      *(const uint32_t *)(map + sub_layout.offset + 16 * sub_layout.rowPitch +
+                          16 * 4);
+   vkUnmapMemory(device, color_mem);
+
+   {
+      void *tmap;
+      if (vkMapMemory(device, tex_mem, 0, VK_WHOLE_SIZE, 0, &tmap) == VK_SUCCESS) {
+         const uint32_t *tp =
+            (const uint32_t *)((const uint8_t *)tmap + tex_layout.offset);
+         printf("tex first: %08x %08x %08x %08x | pitch=%llu\n",
+                tp[0], tp[1], tp[2], tp[3],
+                (unsigned long long)tex_layout.rowPitch);
+         vkUnmapMemory(device, tex_mem);
+      }
+   }
+
+   printf("left=0x%08x right=0x%08x top_left=0x%08x red=%u green=%u other=%u\n",
+          left, right, top_left, red, green, other);
+   if (left != 0xff0000ffu || right != 0xff00ff00u ||
+       red != 2048 || green != 2048 || other) {
+      fprintf(stderr, "FAIL: texture sampling mismatch\n");
+      return 1;
+   }
+   printf("PASS\n");
+   return 0;
+}
