+      (const uint32_t *)(map + sub_layout.offset + 32 * sub_layout.rowPitch + 32 * 4);
+   uint32_t center = *pixels;
+   uint32_t corner = *(const uint32_t *)(map + sub_layout.offset);
+   printf("layout: offset=%llu pitch=%llu size=%llu\n",
