+   CHECK(vkMapMemory(device, ib_mem, 0, sizeof(indices), 0, &ib_map));
+   memcpy(ib_map, indices, sizeof(indices));
+   {
+      VkMappedMemoryRange mr = {
+         .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+         .memory = ib_mem,
+         .offset = 0,
+         .size = VK_WHOLE_SIZE,
+      };
+      CHECK(vkFlushMappedMemoryRanges(device, 1, &mr));
