+                       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+   if (image_mem_type == UINT32_MAX) {
+      fprintf(stderr, "no host-visible image memory (bits 0x%x)\n",
+              image_req.memoryTypeBits);
