+static void
+tu_copy_image_to_image_cpu(struct tu_device *device,
+                           struct tu_image *src_image,
+                           struct tu_image *dst_image,
+                           const VkImageCopy2 *info,
+                           bool copy_memcpy,
+                           const char *src_map,
+                           char *dst_map);
+
+static VkResult
+tu5_image_cpu_map(struct tu_device *device,
+                  struct tu_image *image,
+                  char **map)
+{
+   if (image->mem->bo->map == NULL) {
+      VkResult result = tu_bo_map(device, image->mem->bo, NULL);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   *map = static_cast<char *>(image->mem->bo->map) + image->mem_offset;
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_buffer_cpu_map(struct tu_device *device, struct tu_buffer *buffer)
+{
+   if (buffer->bo->map == NULL)
+      return tu_bo_map(device, buffer->bo, NULL);
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_copy_image_cpu(struct tu_device *device,
+                   struct tu_image *src_image,
+                   struct tu_image *dst_image,
+                   const VkImageCopy2 *info)
+{
+   char *src_map, *dst_map;
+   VkResult result = tu5_image_cpu_map(device, src_image, &src_map);
+   if (result != VK_SUCCESS)
+      return result;
+   result = tu5_image_cpu_map(device, dst_image, &dst_map);
+   if (result != VK_SUCCESS)
+      return result;
+
+   tu_copy_image_to_image_cpu(device, src_image, dst_image, info, false,
+                              src_map, dst_map);
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_copy_buffer_cpu(struct tu_device *device,
+                    struct tu_buffer *src_buffer,
+                    struct tu_buffer *dst_buffer,
+                    const VkBufferCopy2 *region)
+{
+   VkResult result = tu5_buffer_cpu_map(device, src_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+   result = tu5_buffer_cpu_map(device, dst_buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (device->physical_device->has_cached_non_coherent_memory) {
+      tu_bo_sync_cache(device, src_buffer->bo, region->srcOffset,
+                       region->size, TU_MEM_SYNC_CACHE_FROM_GPU);
+   }
+
+   memcpy(static_cast<char *>(dst_buffer->bo->map) + region->dstOffset,
+          static_cast<char *>(src_buffer->bo->map) + region->srcOffset,
+          region->size);
+
+   if (device->physical_device->has_cached_non_coherent_memory) {
+      tu_bo_sync_cache(device, dst_buffer->bo, region->dstOffset,
+                       region->size, TU_MEM_SYNC_CACHE_TO_GPU);
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_fill_buffer_cpu(struct tu_device *device,
+                    struct tu_buffer *buffer,
+                    VkDeviceSize offset,
+                    VkDeviceSize size,
+                    uint32_t data)
+{
+   VkResult result = tu5_buffer_cpu_map(device, buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   char *ptr = static_cast<char *>(buffer->bo->map) + offset;
+   char *end = ptr + size;
+   while (ptr + 4 <= end) {
+      memcpy(ptr, &data, 4);
+      ptr += 4;
+   }
+   if (ptr < end)
+      memcpy(ptr, &data, end - ptr);
+
+   if (device->physical_device->has_cached_non_coherent_memory) {
+      tu_bo_sync_cache(device, buffer->bo, offset, size,
+                       TU_MEM_SYNC_CACHE_TO_GPU);
+   }
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_update_buffer_cpu(struct tu_device *device,
+                      struct tu_buffer *buffer,
+                      VkDeviceSize offset,
+                      VkDeviceSize size,
+                      const void *data)
+{
+   VkResult result = tu5_buffer_cpu_map(device, buffer);
+   if (result != VK_SUCCESS)
+      return result;
+
+   memcpy(static_cast<char *>(buffer->bo->map) + offset, data, size);
+
+   if (device->physical_device->has_cached_non_coherent_memory) {
+      tu_bo_sync_cache(device, buffer->bo, offset, size,
+                       TU_MEM_SYNC_CACHE_TO_GPU);
+   }
+   return VK_SUCCESS;
+}
+
+static bool
+tu5_can_cpu_clear_color(struct tu_image *image,
+                        const VkImageSubresourceRange *range)
+{
+   if (vk_format_is_compressed(image->vk.format) || image->layout[0].ubwc)
+      return false;
+
+   unsigned level_count = range->levelCount == VK_REMAINING_MIP_LEVELS ?
+      image->vk.mip_levels - range->baseMipLevel : range->levelCount;
+   for (unsigned l = 0; l < level_count; l++) {
+      if (fdl_tile_mode(&image->layout[0], range->baseMipLevel + l) != 0)
+         return false;
+   }
+   return true;
+}
+
+static VkResult
+tu5_clear_color_image_cpu(struct tu_device *device,
+                          struct tu_image *image,
+                          const VkClearColorValue *pColor,
+                          const VkImageSubresourceRange *range)
+{
+   enum pipe_format format = vk_format_to_pipe_format(image->vk.format);
+   const struct fdl_layout *layout = &image->layout[0];
+   uint32_t cpp = util_format_get_blocksize(format);
+
+   union util_color uc = {};
+   util_pack_color_union(format, &uc,
+                         reinterpret_cast<const union pipe_color_union *>(pColor));
+
+   char *map;
+   VkResult result = tu5_image_cpu_map(device, image, &map);
+   if (result != VK_SUCCESS)
+      return result;
+
+   unsigned level_count = range->levelCount == VK_REMAINING_MIP_LEVELS ?
+      image->vk.mip_levels - range->baseMipLevel : range->levelCount;
+   bool is_3d = image->vk.image_type == VK_IMAGE_TYPE_3D;
+
+   for (unsigned l = 0; l < level_count; l++) {
+      unsigned level = range->baseMipLevel + l;
+      uint32_t width = u_minify(image->vk.extent.width, level);
+      uint32_t height = u_minify(image->vk.extent.height, level);
+      uint32_t layers = is_3d ? u_minify(image->vk.extent.depth, level) :
+         range->layerCount;
+
+      uint32_t pitch = fdl_pitch(layout, level);
+
+      for (uint32_t layer = 0; layer < layers; layer++) {
+         uint32_t image_offset =
+            fdl_surface_offset(layout, level, range->baseArrayLayer + layer);
+         char *row = map + image_offset;
