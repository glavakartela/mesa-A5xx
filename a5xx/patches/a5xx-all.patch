+                tp[0], tp[1], tp[2], tp[3],
+                (unsigned long long)tex_layout.rowPitch);
+         vkUnmapMemory(device, tex_mem);
+      }
+   }
+
+   printf("left=0x%08x right=0x%08x top_left=0x%08x red=%u green=%u other=%u\n",
+          left, right, top_left, red, green, other);
+   if (left != 0xff0000ffu || right != 0xff00ff00u ||
+       red != 2048 || green != 2048 || other) {
+      fprintf(stderr, "FAIL: texture sampling mismatch\n");
+      return 1;
+   }
+   printf("PASS\n");
+   return 0;
+}
