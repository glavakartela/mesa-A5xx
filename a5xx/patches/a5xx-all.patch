+static bool
+tu5_can_cpu_clear_color(struct tu_image *image,
+                        const VkImageSubresourceRange *range)
+{
+   if (vk_format_is_compressed(image->vk.format) || image->layout[0].ubwc)
+      return false;
+
+   unsigned level_count = range->levelCount == VK_REMAINING_MIP_LEVELS ?
+      image->vk.mip_levels - range->baseMipLevel : range->levelCount;
+   for (unsigned l = 0; l < level_count; l++) {
+      if (fdl_tile_mode(&image->layout[0], range->baseMipLevel + l) != 0)
+         return false;
+   }
+   return true;
+}
+
+static VkResult
+tu5_clear_color_image_cpu(struct tu_device *device,
+                          struct tu_image *image,
+                          const VkClearColorValue *pColor,
+                          const VkImageSubresourceRange *range)
+{
+   enum pipe_format format = vk_format_to_pipe_format(image->vk.format);
+   const struct fdl_layout *layout = &image->layout[0];
+   uint32_t cpp = util_format_get_blocksize(format);
+
+   union util_color uc = {};
+   util_pack_color_union(format, &uc,
+                         reinterpret_cast<const union pipe_color_union *>(pColor));
+
+   char *map;
+   VkResult result = tu5_image_cpu_map(device, image, &map);
+   if (result != VK_SUCCESS)
+      return result;
+
+   unsigned level_count = range->levelCount == VK_REMAINING_MIP_LEVELS ?
+      image->vk.mip_levels - range->baseMipLevel : range->levelCount;
+   bool is_3d = image->vk.image_type == VK_IMAGE_TYPE_3D;
+
+   for (unsigned l = 0; l < level_count; l++) {
+      unsigned level = range->baseMipLevel + l;
+      uint32_t width = u_minify(image->vk.extent.width, level);
+      uint32_t height = u_minify(image->vk.extent.height, level);
+      uint32_t layers = is_3d ? u_minify(image->vk.extent.depth, level) :
+         range->layerCount;
+
+      uint32_t pitch = fdl_pitch(layout, level);
+
+      for (uint32_t layer = 0; layer < layers; layer++) {
+         uint32_t image_offset =
+            fdl_surface_offset(layout, level, range->baseArrayLayer + layer);
+         char *row = map + image_offset;
+
+         /* Build one row and replicate it; padding is left untouched. */
+         for (uint32_t x = 0; x < width; x++)
+            memcpy(row + x * cpp, &uc, cpp);
+         for (uint32_t y = 1; y < height; y++)
+            memcpy(row + y * pitch, row, width * cpp);
+      }
+   }
+
+   if (image->mem->bo->cached_non_coherent) {
+      tu_bo_sync_cache(device, image->mem->bo, image->mem_offset,
+                       VK_WHOLE_SIZE, TU_MEM_SYNC_CACHE_TO_GPU);
+   }
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_copy_buffer_to_image(struct tu_device *device,
+                         struct tu_buffer *src_buffer,
+                         struct tu_image *dst_image,
+                         const VkBufferImageCopy2 *info)
+{
+   VkResult result = tu_bo_map(device, src_buffer->bo, NULL);
+   if (result != VK_SUCCESS)
+      return result;
+
+   char *image_map;
+   result = tu5_image_cpu_map(device, dst_image, &image_map);
+   if (result != VK_SUCCESS)
+      return result;
+
+   if (src_buffer->bo->cached_non_coherent) {
+      tu_bo_sync_cache(device, src_buffer->bo, info->bufferOffset,
+                       VK_WHOLE_SIZE, TU_MEM_SYNC_CACHE_FROM_GPU);
+   }
+
+   VkMemoryToImageCopyEXT copy = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_TO_IMAGE_COPY_EXT,
+      .pHostPointer = static_cast<char *>(src_buffer->bo->map) + info->bufferOffset,
+      .memoryRowLength = info->bufferRowLength,
+      .memoryImageHeight = info->bufferImageHeight,
+      .imageSubresource = info->imageSubresource,
+      .imageOffset = info->imageOffset,
+      .imageExtent = info->imageExtent,
+   };
+
+   tu_copy_memory_to_image(device, dst_image, image_map, &copy, false);
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu5_copy_image_to_buffer(struct tu_device *device,
+                         struct tu_image *src_image,
+                         struct tu_buffer *dst_buffer,
+                         const VkBufferImageCopy2 *info)
+{
+   VkResult result = tu_bo_map(device, dst_buffer->bo, NULL);
+   if (result != VK_SUCCESS)
+      return result;
+
+   char *image_map;
+   result = tu5_image_cpu_map(device, src_image, &image_map);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VkImageToMemoryCopyEXT copy = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_TO_MEMORY_COPY_EXT,
+      .pHostPointer = static_cast<char *>(dst_buffer->bo->map) + info->bufferOffset,
+      .memoryRowLength = info->bufferRowLength,
+      .memoryImageHeight = info->bufferImageHeight,
+      .imageSubresource = info->imageSubresource,
+      .imageOffset = info->imageOffset,
+      .imageExtent = info->imageExtent,
+   };
+
+   tu_copy_image_to_memory(device, src_image, image_map, &copy, false);
+
+   if (dst_buffer->bo->cached_non_coherent) {
+      tu_bo_sync_cache(device, dst_buffer->bo, info->bufferOffset,
+                       VK_WHOLE_SIZE, TU_MEM_SYNC_CACHE_TO_GPU);
+   }
+
+   return VK_SUCCESS;
+}
