+++ b/a5xx/tests/tu5_texvb_noflush_test.c
@@ -0,0 +1,568 @@
+#include <vulkan/vulkan.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(x) do { \
+   VkResult r_ = (x); \
+   if (r_ != VK_SUCCESS) { \
