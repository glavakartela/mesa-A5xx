+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   CHECK(vkBeginCommandBuffer(cmd, &begin));
+
+   VkClearValue clear = { .color = { .float32 = { 0, 0, 0, 1 } } };
+   VkRenderPassBeginInfo rp_begin = {
+      .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+      .renderPass = render_pass,
+      .framebuffer = framebuffer,
+      .renderArea = { { 0, 0 }, { width, height } },
+      .clearValueCount = 1,
+      .pClearValues = &clear,
+   };
+   vkCmdBeginRenderPass(cmd, &rp_begin, VK_SUBPASS_CONTENTS_INLINE);
+   vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+   VkDeviceSize vb_offset = 0;
+   vkCmdBindVertexBuffers(cmd, 0, 1, &vbo, &vb_offset);
+   vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, 0, 1,
+                           &desc_set, 0, NULL);
+   vkCmdDraw(cmd, 3, 1, 0, 0);
+   vkCmdEndRenderPass(cmd);
+   CHECK(vkEndCommandBuffer(cmd));
+
+   VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cmd,
+   };
+   CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE));
+   CHECK(vkQueueWaitIdle(queue));
+   printf("rendered\n");
+
+   VkImageSubresource subres = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT };
+   VkSubresourceLayout sub_layout;
+   vkGetImageSubresourceLayout(device, color_image, &subres, &sub_layout);
+   uint8_t *map;
+   CHECK(vkMapMemory(device, color_mem, 0, VK_WHOLE_SIZE, 0, (void **)&map));
+
+   unsigned red = 0, green = 0, other = 0;
+   for (uint32_t y = 0; y < height; y++) {
+      const uint32_t *row =
+         (const uint32_t *)(map + sub_layout.offset + y * sub_layout.rowPitch);
+      for (uint32_t x = 0; x < width; x++) {
+         if (row[x] == 0xff0000ffu)
+            red++;
+         else if (row[x] == 0xff00ff00u)
+            green++;
+         else
+            other++;
+      }
+   }
+   uint32_t left =
+      *(const uint32_t *)(map + sub_layout.offset + 32 * sub_layout.rowPitch +
+                          16 * 4);
+   uint32_t right =
+      *(const uint32_t *)(map + sub_layout.offset + 32 * sub_layout.rowPitch +
+                          48 * 4);
+   uint32_t top_left =
+      *(const uint32_t *)(map + sub_layout.offset + 16 * sub_layout.rowPitch +
+                          16 * 4);
+   vkUnmapMemory(device, color_mem);
+
+   printf("left=0x%08x right=0x%08x top_left=0x%08x unique=%u\n",
+          left, right, top_left, red + green + other);
+   if (left == right && right == top_left) {
+      fprintf(stderr, "FAIL: varying is constant 0x%08x\n", left);
+      return 1;
+   }
+   printf("PASS\n");
+   return 0;
+}
