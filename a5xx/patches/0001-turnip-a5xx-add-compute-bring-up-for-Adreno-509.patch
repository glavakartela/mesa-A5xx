+#define TU5_REG_HLSQ_CS_NDRANGE_3           0x0000e7b3
+#define TU5_REG_HLSQ_CS_NDRANGE_4           0x0000e7b4
+#define TU5_REG_HLSQ_CS_NDRANGE_5           0x0000e7b5
