    tu5_emit_reg(cs, REG_A5XX_PC_POWER_CNTL, num_sp_cores - 1);
@@ -1440,8 +1753,11 @@ tu5_draw(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info)
 
    if (getenv("TU5_GFX_POSTCLEAR"))
       tu5_emit_clear(cmd, 0x00ff00ffu);
