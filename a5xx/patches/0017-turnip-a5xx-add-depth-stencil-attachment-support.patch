@@ -1327,6 +1638,8 @@ tu5_draw(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info)
    tu5_emit_global_state(cmd);
    if (!tu5_gfx_no_invalidate()) {
       tu5_event_write(cs, PC_CCU_INVALIDATE_COLOR);
