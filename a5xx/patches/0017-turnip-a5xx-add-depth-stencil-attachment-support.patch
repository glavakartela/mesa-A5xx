    /* Flush UCHE/CCU writes so CPU readback sees them (same sequence as the
     * a5xx compute path).
diff --git a/src/freedreno/vulkan/tu_image.cc b/src/freedreno/vulkan/tu_image.cc
index 568dba9..198984d 100644
--- a/src/freedreno/vulkan/tu_image.cc
+++ b/src/freedreno/vulkan/tu_image.cc
@@ -566,12 +566,17 @@ tu_image_init(struct tu_device *device, struct tu_image *image,
       force_linear_tile = true;
    }
 
-   /* The a5xx sysmem path only understands linear images: its MRT/texture
-    * descriptors use TILE5_LINEAR and there is no UBWC support.
+   /* The a5xx sysmem path only understands linear color images: its MRT
+    * descriptors use TILE5_LINEAR and there is no UBWC support. Depth/stencil
+    * is the exception: the hardware does not support linear D/S (fdl6 also
+    * forces tiling for it), and RB_DEPTH_BUFFER_INFO has no tile-mode field,
