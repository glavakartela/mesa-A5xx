From 851d01c7485269542ef68ffc32c4e5baeb4dd8e7 Mon Sep 17 00:00:00 2001
From: local <local@local>
Date: Thu, 19 Nov 2026 21:37:52 +0200
Subject: [PATCH 05/29] turnip/a5xx: upload compute push constants

Emit CP_LOAD_STATE4 constants for the per-stage push constant range before
each a5xx dispatch. The smoke test now passes an addend via
vkCmdPushConstants and still produces the expected 512/512 values.

Generated-by: LLM
---
 src/freedreno/vulkan/tu5_compute.cc | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/src/freedreno/vulkan/tu5_compute.cc b/src/freedreno/vulkan/tu5_compute.cc
index cc4210f..ecc6bcb 100644
--- a/src/freedreno/vulkan/tu5_compute.cc
+++ b/src/freedreno/vulkan/tu5_compute.cc
@@ -280,6 +280,32 @@ tu5_emit_ssbo_state(struct tu_cmd_buffer *cmd)
    }
 }
 
+static void
+tu5_emit_push_consts(struct tu_cmd_buffer *cmd,
+                     const struct ir3_shader_variant *v)
+{
+   const struct tu_shader *shader = cmd->state.shaders[MESA_SHADER_COMPUTE];
+   const struct tu_push_constant_range *pc = &shader->const_state.push_consts;
+
+   if (pc->type != IR3_PUSH_CONSTS_PER_STAGE || pc->dwords == 0)
+      return;
+
+   unsigned units = DIV_ROUND_UP(pc->dwords, 4);
+
+   tu_cs_emit_pkt7(&cmd->cs, CP_LOAD_STATE4, 3 + units * 4);
+   tu_cs_emit(&cmd->cs, CP_LOAD_STATE4_0_DST_OFF(pc->lo_dwords / 4) |
+                            CP_LOAD_STATE4_0_STATE_SRC(SS4_DIRECT) |
+                            CP_LOAD_STATE4_0_STATE_BLOCK(SB4_CS_SHADER) |
+                            CP_LOAD_STATE4_0_NUM_UNIT(units));
+   tu_cs_emit(&cmd->cs, CP_LOAD_STATE4_1_STATE_TYPE(ST4_CONSTANTS) |
+                            CP_LOAD_STATE4_1_EXT_SRC_ADDR(0));
+   tu_cs_emit(&cmd->cs, CP_LOAD_STATE4_2_EXT_SRC_ADDR_HI(0));
+
+   for (unsigned i = 0; i < units * 4; i++)
+      tu_cs_emit(&cmd->cs,
+                 i < pc->dwords ? cmd->push_constants[i] : 0);
+}
+
 void
 tu5_dispatch(struct tu_cmd_buffer *cmd, const struct tu_dispatch_info *info)
 {
@@ -295,6 +321,7 @@ tu5_dispatch(struct tu_cmd_buffer *cmd, const struct tu_dispatch_info *info)
 
    tu5_emit_flush(cmd);
    tu5_emit_driver_params(cmd, v, info);
+   tu5_emit_push_consts(cmd, v);
    tu5_emit_ssbo_state(cmd);
 
    const uint16_t *local_size = v->local_size;
