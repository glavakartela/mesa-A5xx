+         fclose(f);
+      }
+   }
+
    if (dev->physical_device->info->chip == 5 && getenv("TU5_GFX_DEBUG")) {
       const struct ir3_shader_variant *v = shader->variant;
       fprintf(stderr, "tu5 shader stage=%u: inputs=%u outputs=%u total_in=%u"
