+         if (result != VK_SUCCESS)
+            vk_device_set_lost(&cmd->device->vk, "a5xx image copy failed");
+      }
+      return;
+   }
+
    trace_start_copy_image(&cmd->trace, &cmd->cs, cmd, src_image->vk.format,
                           dst_image->vk.format);
 
