+   CHECK(vkCreateDevice(phys[0], &dev_info, NULL, &device));
+
+   VkQueue queue;
+   vkGetDeviceQueue(device, queue_family, 0, &queue);
+
+   static const float verts[4] = { -0.5f, -0.5f, 0.5f, 0.5f };
