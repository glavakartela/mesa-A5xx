+      unsigned changed = 0, red = 0;
+      for (unsigned y = 0; y < height; y++) {
+         const uint32_t *row = (const uint32_t *)(map + sub_layout.offset +
+                              y * sub_layout.rowPitch);
+         for (unsigned x = 0; x < width; x++) {
+            if (row[x] != 0xa5a5a5a5u)
+               changed++;
+            if (row[x] == 0xff0000ffu)
