+   CHECK(vkCreateBuffer(device, &ubo_info, NULL, &ubo));
+   VkMemoryRequirements ubo_req;
+   vkGetBufferMemoryRequirements(device, ubo, &ubo_req);
+   VkMemoryAllocateInfo ubo_ai = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = ubo_req.size,
+      .memoryTypeIndex = find_memory_type(phys[0], ubo_req.memoryTypeBits,
+         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT),
+   };
+   VkDeviceMemory ubo_mem;
+   CHECK(vkAllocateMemory(device, &ubo_ai, NULL, &ubo_mem));
+   CHECK(vkBindBufferMemory(device, ubo, ubo_mem, 0));
