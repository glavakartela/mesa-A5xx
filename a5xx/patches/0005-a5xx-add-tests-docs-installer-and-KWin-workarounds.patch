+   VkDeviceMemory tex_mem;
+   CHECK(vkAllocateMemory(device, &tex_alloc, NULL, &tex_mem));
+   CHECK(vkBindImageMemory(device, tex_image, tex_mem, 0));
+
+   VkImageSubresource tex_subres = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT };
+   VkSubresourceLayout tex_layout;
+   vkGetImageSubresourceLayout(device, tex_image, &tex_subres, &tex_layout);
+   printf("tex layout: offset=%llu pitch=%llu\n",
+          (unsigned long long)tex_layout.offset,
+          (unsigned long long)tex_layout.rowPitch);
+
+   /* Staging buffer, tightly packed RGBA8, filled by the CPU and copied to
+    * the image with vkCmdCopyBufferToImage. */
+   const VkDeviceSize tex_bytes = (VkDeviceSize)width * height * 4;
+   VkBufferCreateInfo stg_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = tex_bytes,
+      .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkBuffer stg_buffer;
+   CHECK(vkCreateBuffer(device, &stg_info, NULL, &stg_buffer));
+   VkMemoryRequirements stg_req;
+   vkGetBufferMemoryRequirements(device, stg_buffer, &stg_req);
+   uint32_t stg_mem_type =
+      find_memory_type(phys[0], stg_req.memoryTypeBits,
+                       VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+   VkMemoryAllocateInfo stg_alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = stg_req.size,
+      .memoryTypeIndex = stg_mem_type,
+   };
+   VkDeviceMemory stg_mem;
+   CHECK(vkAllocateMemory(device, &stg_alloc, NULL, &stg_mem));
+   CHECK(vkBindBufferMemory(device, stg_buffer, stg_mem, 0));
+   {
+      uint8_t *map;
+      CHECK(vkMapMemory(device, stg_mem, 0, VK_WHOLE_SIZE, 0, (void **)&map));
+      for (uint32_t y = 0; y < height; y++) {
+         uint32_t *row = (uint32_t *)(map + y * width * 4);
+         for (uint32_t x = 0; x < width; x++)
+            row[x] = x < width / 2 ? 0xff0000ffu : 0xff00ff00u;
+      }
+      /* deliberately no vkFlushMappedMemoryRanges: the driver syncs on unmap */
+      vkUnmapMemory(device, stg_mem);
