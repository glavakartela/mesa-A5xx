+   CHECK(vkQueueWaitIdle(queue));
+   printf("rendered\n");
+   {
+      volatile uint32_t *p = (volatile uint32_t *)probe_map;
+      printf("probe:");
+      for (unsigned i = 0; i < 16; i++)
+         printf(" %08x", p[i]);
+      printf("\n");
+   }
