+         vkUnmapMemory(device, tex_mem);
+      }
+      printf("recorded (no submit)\n");
+      return 0;
+   }
+
+   VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cmd,
