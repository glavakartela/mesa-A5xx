+   CHECK(vkAllocateCommandBuffers(device, &cmd_info, &cmd));
+
+   VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   CHECK(vkBeginCommandBuffer(cmd, &begin));
