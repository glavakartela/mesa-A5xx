+   memcpy(ubo_map, positions, sizeof(positions));
+   vkUnmapMemory(device, ubo_mem);
+
+   VkDescriptorSetLayoutBinding dsl_binding = {
+      .binding = 0,
+      .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
+      .descriptorCount = 1,
+      .stageFlags = VK_SHADER_STAGE_VERTEX_BIT,
+   };
+   VkDescriptorSetLayoutCreateInfo dsl_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 1,
+      .pBindings = &dsl_binding,
+   };
+   VkDescriptorSetLayout dsl;
+   CHECK(vkCreateDescriptorSetLayout(device, &dsl_info, NULL, &dsl));
+   VkDescriptorPoolSize pool_size = {
+      .type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
+      .descriptorCount = 1,
+   };
+   VkDescriptorPoolCreateInfo dp_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = 1,
+      .poolSizeCount = 1,
+      .pPoolSizes = &pool_size,
+   };
+   VkDescriptorPool dp;
+   CHECK(vkCreateDescriptorPool(device, &dp_info, NULL, &dp));
+   VkDescriptorSetAllocateInfo ds_alloc = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = dp,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &dsl,
+   };
+   VkDescriptorSet ds;
+   CHECK(vkAllocateDescriptorSets(device, &ds_alloc, &ds));
+   VkDescriptorBufferInfo db_info = {
+      .buffer = ubo, .offset = 0, .range = sizeof(positions),
+   };
+   VkWriteDescriptorSet write = {
+      .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+      .dstSet = ds, .dstBinding = 0, .descriptorCount = 1,
+      .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
+      .pBufferInfo = &db_info,
+   };
+   vkUpdateDescriptorSets(device, 1, &write, 0, NULL);
+
+   const uint32_t width = 64, height = 64;
+   VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
