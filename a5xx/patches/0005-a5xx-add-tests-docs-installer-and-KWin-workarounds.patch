--- /dev/null
+++ b/a5xx/tests/build-all.sh
@@ -0,0 +1,50 @@
+#!/bin/sh
+# Build the a5xx Turnip test programs.
+# Usage:
+#   CROSS=/path/to/aarch64-alarm-gcc ROOTFS=/path/to/rootfs ./build-all.sh
+set -eu
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+CROSS=${CROSS:-aarch64-alarm-gcc}
+ROOTFS=${ROOTFS:-/home/user/rootfs}
+VK=${VK:-$ROOTFS/usr/lib/libvulkan.so.1.4.357}
+WAYLAND=${WAYLAND:-$ROOTFS/usr/lib/libwayland-client.so.0.26.0}
+
+[ -x "$CROSS" ] || command -v "$CROSS" >/dev/null || {
+   echo "CROSS not found: $CROSS" >&2
+   exit 1
+}
+[ -f "$VK" ] || { echo "missing $VK" >&2; exit 1; }
+
+cd "$HERE"
+
+# Shaders: regenerate .inc if glslc is available, otherwise use the
+# checked-in generated includes.
+if command -v glslc >/dev/null 2>&1; then
+   for f in *.vert; do
+      [ -f "$f" ] || continue
+      base=${f%.vert}
+      glslc -fshader-stage=vert --target-env=vulkan1.0 -mfmt=c \
+         "$f" -o "${base}_vert.inc"
+   done
+   for f in *.frag; do
+      [ -f "$f" ] || continue
+      base=${f%.frag}
+      glslc -fshader-stage=frag --target-env=vulkan1.0 -mfmt=c \
+         "$f" -o "${base}_frag.inc"
+   done
+fi
+
+for src in tu5_*.c; do
+   [ "$src" = "tu5_wl_wsi_test.c" ] && continue
+   out=${src%.c}
+   echo "CC $out"
+   "$CROSS" -O2 -Wall -I. -o "$out" "$src" "$VK"
+done
+
+echo "CC tu5_wl_wsi_test"
+"$CROSS" -O2 -Wall -I. -I"$ROOTFS/usr/include" \
+   -o tu5_wl_wsi_test tu5_wl_wsi_test.c xdg-shell-protocol.c \
+   "$WAYLAND" "$VK"
+
+echo "done"
diff --git a/a5xx/tests/build.sh b/a5xx/tests/build.sh
new file mode 100755
index 0000000..4eed5d2
--- /dev/null
+++ b/a5xx/tests/build.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Cross-build the a5xx Turnip compute smoke test.
+set -eu
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+BASE=$(cd "$HERE/.." && pwd)
+CROSS=${CROSS:-$BASE/cross/bin/aarch64-alarm-gcc}
+SYSROOT=${SYSROOT:-$BASE/sysroot}
+ROOTFS=${ROOTFS:-/home/user/rootfs}
+
+if [ ! -f "$HERE/ssbo_spv.h" ]; then
+   glslc -fshader-stage=comp --target-env=vulkan1.0 -mfmt=c \
+      "$HERE/ssbo.comp" -o "$HERE/ssbo_spv.inc"
+   printf '#pragma once\n#include <stdint.h>\nstatic const uint32_t ssbo_spv[] =\n#include "ssbo_spv.inc"\n;\n' \
+      > "$HERE/ssbo_spv.h"
+fi
+
+# Link against the real loader object instead of -L$ROOTFS/usr/lib: the
+# rootfs libc.so is a linker script with absolute phone paths, which makes
+# the host linker pick up x86_64 libraries.
+"$CROSS" -O2 -Wall -o "$HERE/tu5_test" "$HERE/tu5_test.c" -I"$HERE" \
+   "$ROOTFS/usr/lib/libvulkan.so.1.4.357"
+
+echo "built: $HERE/tu5_test"
+file "$HERE/tu5_test"
diff --git a/a5xx/tests/collect-logs.sh b/a5xx/tests/collect-logs.sh
new file mode 100755
index 0000000..aa09311
--- /dev/null
+++ b/a5xx/tests/collect-logs.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+# Collect kernel/driver logs after a run or a suspected hang.
+# Needs root (sudo) for dmesg/journal.
+set -u
+
+OUT=${OUT:-/home/user/a5xx-logs-$(date +%Y%m%d-%H%M%S)}
+mkdir -p "$OUT"
+
+{
+   uname -a
+   uptime
+   echo "--- vulkan"
+   env -u VK_ICD_FILENAMES -u VK_DRIVER_FILES vulkaninfo --summary 2>&1
+   echo "--- sessions"
+   loginctl list-sessions --no-legend 2>&1
+   echo "--- gpu"
+   cat /sys/class/kgsl/kgsl-3d0/gpuclk 2>/dev/null
+   for z in /sys/class/thermal/thermal_zone*/temp; do
+      printf '%s=%s\n' "$z" "$(cat "$z" 2>/dev/null)"
+   done
+} > "$OUT/status.txt" 2>&1
+
+if command -v sudo >/dev/null 2>&1; then
+   sudo dmesg > "$OUT/dmesg-current.txt" 2>&1 || true
+   sudo journalctl -k -b 0 --no-pager > "$OUT/journal-current.txt" 2>&1 || true
+   sudo journalctl -k -b -1 --no-pager > "$OUT/journal-prev.txt" 2>&1 || true
+   sudo ls -l /sys/fs/pstore > "$OUT/pstore-list.txt" 2>&1 || true
+   mkdir -p "$OUT/pstore"
+   sudo cp -a /sys/fs/pstore/. "$OUT/pstore/" 2>/dev/null || true
+fi
+
+echo "collected to $OUT"
