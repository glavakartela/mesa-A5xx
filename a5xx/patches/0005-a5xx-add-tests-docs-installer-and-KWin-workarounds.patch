+
+   VkClearValue clear = { .color = { .float32 = { 0, 0, 0, 1 } } };
+   VkRenderPassBeginInfo rp_begin = {
+      .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+      .renderPass = render_pass,
+      .framebuffer = framebuffer,
+      .renderArea = { { 0, 0 }, { width, height } },
