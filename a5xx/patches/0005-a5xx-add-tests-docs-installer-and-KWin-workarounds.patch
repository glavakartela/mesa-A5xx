+         .samples = VK_SAMPLE_COUNT_1_BIT,
+         .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+         .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+         .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+         .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+         .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+         .finalLayout = VK_IMAGE_LAYOUT_GENERAL,
+      },
+      {
+         .format = depth_format,
+         .samples = VK_SAMPLE_COUNT_1_BIT,
+         .loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+         .storeOp = VK_ATTACHMENT_STORE_OP_STORE,
+         .stencilLoadOp = VK_ATTACHMENT_LOAD_OP_CLEAR,
+         .stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE,
+         .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+         .finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+      },
+   };
+   VkAttachmentReference color_ref = {
+      .attachment = 0,
+      .layout = VK_IMAGE_LAYOUT_GENERAL,
+   };
+   VkAttachmentReference depth_ref = {
+      .attachment = 1,
+      .layout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL,
+   };
+   VkSubpassDescription subpass = {
+      .pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &color_ref,
+      .pDepthStencilAttachment = &depth_ref,
+   };
+   VkRenderPassCreateInfo rp_info = {
+      .sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO,
+      .attachmentCount = 2,
+      .pAttachments = att,
+      .subpassCount = 1,
+      .pSubpasses = &subpass,
+   };
+   VkRenderPass render_pass;
+   CHECK(vkCreateRenderPass(device, &rp_info, NULL, &render_pass));
+
+   VkImageView fb_views[2] = { color_view, depth_view };
+   VkFramebufferCreateInfo fb_info = {
+      .sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO,
+      .renderPass = render_pass,
+      .attachmentCount = 2,
+      .pAttachments = fb_views,
+      .width = width,
+      .height = height,
+      .layers = 1,
+   };
+   VkFramebuffer framebuffer;
+   CHECK(vkCreateFramebuffer(device, &fb_info, NULL, &framebuffer));
+
+   /* Full-screen red with stencil ALWAYS/REPLACE ref=1, then a left triangle
+    * with EQUAL ref=0 (must fail) and a right triangle with EQUAL ref=1
+    * (must pass).
+    */
+   static const float verts[27] = {
+      -1.0f, -1.0f, 0.5f,   3.0f, -1.0f, 0.5f,  -1.0f, 3.0f, 0.5f,
+      -0.75f, -0.3f, 0.5f, -0.25f, -0.3f, 0.5f, -0.5f, 0.3f, 0.5f,
+       0.25f, -0.3f, 0.5f,  0.75f, -0.3f, 0.5f,  0.5f, 0.3f, 0.5f,
+   };
+   VkBufferCreateInfo vb_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = sizeof(verts),
+      .usage = VK_BUFFER_USAGE_VERTEX_BUFFER_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkBuffer vbo;
+   CHECK(vkCreateBuffer(device, &vb_info, NULL, &vbo));
+   VkMemoryRequirements vb_req;
+   vkGetBufferMemoryRequirements(device, vbo, &vb_req);
+   uint32_t vb_mem_type =
+      find_memory_type(phys[0], vb_req.memoryTypeBits,
+                       VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                       VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+   VkMemoryAllocateInfo vb_alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = vb_req.size,
+      .memoryTypeIndex = vb_mem_type,
+   };
+   VkDeviceMemory vb_mem;
+   CHECK(vkAllocateMemory(device, &vb_alloc, NULL, &vb_mem));
+   CHECK(vkBindBufferMemory(device, vbo, vb_mem, 0));
+   {
+      void *map;
+      CHECK(vkMapMemory(device, vb_mem, 0, sizeof(verts), 0, &map));
+      memcpy(map, verts, sizeof(verts));
+      vkUnmapMemory(device, vb_mem);
+   }
+
+   VkShaderModule vert = make_shader(device, vert_spv, sizeof(vert_spv));
+   VkShaderModule red = make_shader(device, red_spv, sizeof(red_spv));
+   VkShaderModule blue = make_shader(device, blue_spv, sizeof(blue_spv));
+   VkShaderModule green = make_shader(device, green_spv, sizeof(green_spv));
+
+   VkVertexInputBindingDescription vb_binding = {
+      .binding = 0,
+      .stride = 12,
+      .inputRate = VK_VERTEX_INPUT_RATE_VERTEX,
+   };
+   VkVertexInputAttributeDescription vb_attr = {
+      .location = 0,
+      .binding = 0,
+      .format = VK_FORMAT_R32G32B32_SFLOAT,
+      .offset = 0,
+   };
+   VkPipelineVertexInputStateCreateInfo vi = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+      .vertexBindingDescriptionCount = 1,
+      .pVertexBindingDescriptions = &vb_binding,
+      .vertexAttributeDescriptionCount = 1,
+      .pVertexAttributeDescriptions = &vb_attr,
+   };
+   VkPipelineInputAssemblyStateCreateInfo ia = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+   };
+   VkViewport viewport = {
+      .x = 0, .y = 0, .width = width, .height = height,
+      .minDepth = 0, .maxDepth = 1,
+   };
+   VkRect2D scissor = { { 0, 0 }, { width, height } };
+   VkPipelineViewportStateCreateInfo vp = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .pViewports = &viewport,
+      .scissorCount = 1,
+      .pScissors = &scissor,
+   };
+   VkPipelineRasterizationStateCreateInfo rs = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE,
+      .lineWidth = 1.0f,
+   };
+   VkPipelineMultisampleStateCreateInfo ms = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   VkStencilOpState stencil_replace = {
+      .failOp = VK_STENCIL_OP_KEEP,
+      .passOp = VK_STENCIL_OP_REPLACE,
+      .depthFailOp = VK_STENCIL_OP_KEEP,
+      .compareOp = VK_COMPARE_OP_ALWAYS,
+      .compareMask = 0xff,
+      .writeMask = 0xff,
+      .reference = 1,
+   };
+   VkStencilOpState stencil_eq0 = {
+      .failOp = VK_STENCIL_OP_KEEP,
+      .passOp = VK_STENCIL_OP_KEEP,
+      .depthFailOp = VK_STENCIL_OP_KEEP,
+      .compareOp = VK_COMPARE_OP_EQUAL,
+      .compareMask = 0xff,
+      .writeMask = 0xff,
+      .reference = 0,
+   };
+   VkStencilOpState stencil_eq1 = stencil_eq0;
+   stencil_eq1.reference = 1;
+
+   VkPipelineDepthStencilStateCreateInfo ds[3] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO,
+         .depthTestEnable = VK_FALSE,
+         .depthWriteEnable = VK_FALSE,
+         .depthCompareOp = VK_COMPARE_OP_ALWAYS,
+         .depthBoundsTestEnable = VK_FALSE,
+         .stencilTestEnable = VK_TRUE,
+         .front = stencil_replace,
+         .back = stencil_replace,
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO,
+         .depthTestEnable = VK_FALSE,
+         .depthWriteEnable = VK_FALSE,
+         .depthCompareOp = VK_COMPARE_OP_ALWAYS,
+         .depthBoundsTestEnable = VK_FALSE,
+         .stencilTestEnable = VK_TRUE,
+         .front = stencil_eq0,
+         .back = stencil_eq0,
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO,
+         .depthTestEnable = VK_FALSE,
+         .depthWriteEnable = VK_FALSE,
+         .depthCompareOp = VK_COMPARE_OP_ALWAYS,
+         .depthBoundsTestEnable = VK_FALSE,
+         .stencilTestEnable = VK_TRUE,
+         .front = stencil_eq1,
+         .back = stencil_eq1,
+      },
+   };
+   VkPipelineColorBlendAttachmentState cb_att = {
+      .blendEnable = VK_FALSE,
+      .colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT |
+                        VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT,
+   };
+   VkPipelineColorBlendStateCreateInfo cb = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &cb_att,
+   };
+   VkPipelineLayoutCreateInfo pl_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+   };
+   VkPipelineLayout layout;
+   CHECK(vkCreatePipelineLayout(device, &pl_info, NULL, &layout));
+
+   VkShaderModule frags[3] = { red, blue, green };
+   VkPipeline pipelines[3];
+   for (unsigned i = 0; i < 3; i++) {
+      VkPipelineShaderStageCreateInfo stages[2] = {
+         { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+           .stage = VK_SHADER_STAGE_VERTEX_BIT, .module = vert,
+           .pName = "main" },
+         { .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+           .stage = VK_SHADER_STAGE_FRAGMENT_BIT, .module = frags[i],
+           .pName = "main" },
+      };
+      VkGraphicsPipelineCreateInfo gp_info = {
+         .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+         .stageCount = 2,
+         .pStages = stages,
+         .pVertexInputState = &vi,
+         .pInputAssemblyState = &ia,
+         .pViewportState = &vp,
+         .pRasterizationState = &rs,
+         .pMultisampleState = &ms,
+         .pDepthStencilState = &ds[i],
+         .pColorBlendState = &cb,
+         .layout = layout,
+         .renderPass = render_pass,
+         .subpass = 0,
+      };
+      CHECK(vkCreateGraphicsPipelines(device, VK_NULL_HANDLE, 1, &gp_info,
+                                      NULL, &pipelines[i]));
+   }
+   printf("graphics pipelines created\n");
+
+   VkCommandPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = queue_family,
+   };
+   VkCommandPool pool;
+   CHECK(vkCreateCommandPool(device, &pool_info, NULL, &pool));
+
+   VkCommandBufferAllocateInfo cmd_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = pool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer cmd;
+   CHECK(vkAllocateCommandBuffers(device, &cmd_info, &cmd));
+
+   VkCommandBufferBeginInfo begin = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+   };
+   CHECK(vkBeginCommandBuffer(cmd, &begin));
+
+   VkClearValue clears[2] = {
+      { .color = { .float32 = { 0, 1, 0, 1 } } },
+      { .depthStencil = { .depth = 1.0f, .stencil = 0 } },
+   };
+   VkRenderPassBeginInfo rp_begin = {
+      .sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO,
+      .renderPass = render_pass,
+      .framebuffer = framebuffer,
+      .renderArea = { { 0, 0 }, { width, height } },
+      .clearValueCount = 2,
+      .pClearValues = clears,
+   };
+   vkCmdBeginRenderPass(cmd, &rp_begin, VK_SUBPASS_CONTENTS_INLINE);
+
+   VkDeviceSize offset = 0;
+   vkCmdBindVertexBuffers(cmd, 0, 1, &vbo, &offset);
+   vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipelines[0]);
+   vkCmdDraw(cmd, 3, 1, 0, 0);
+
+   offset = 9 * sizeof(float);
+   vkCmdBindVertexBuffers(cmd, 0, 1, &vbo, &offset);
+   vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipelines[1]);
+   vkCmdDraw(cmd, 3, 1, 0, 0);
+
+   offset = 18 * sizeof(float);
+   vkCmdBindVertexBuffers(cmd, 0, 1, &vbo, &offset);
+   vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipelines[2]);
+   vkCmdDraw(cmd, 3, 1, 0, 0);
+
+   vkCmdEndRenderPass(cmd);
+   CHECK(vkEndCommandBuffer(cmd));
+
+   VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cmd,
+   };
+   CHECK(vkQueueSubmit(queue, 1, &submit, VK_NULL_HANDLE));
+   CHECK(vkQueueWaitIdle(queue));
+   printf("rendered\n");
+
+   VkImageSubresource subres = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT };
+   VkSubresourceLayout sub_layout;
+   vkGetImageSubresourceLayout(device, color_image, &subres, &sub_layout);
+
+   uint8_t *map;
+   CHECK(vkMapMemory(device, color_mem, 0, VK_WHOLE_SIZE, 0, (void **)&map));
+
+   unsigned red_count = 0, blue_count = 0, green_count = 0, clear_count = 0,
+            other_count = 0;
+   for (unsigned y = 0; y < height; y++) {
+      const uint32_t *row =
+         (const uint32_t *)(map + sub_layout.offset + y * sub_layout.rowPitch);
+      for (unsigned x = 0; x < width; x++) {
+         switch (row[x]) {
+         case 0xff0000ffu: red_count++; break;
+         case 0xffff0000u: blue_count++; break;
+         case 0xff00ff00u: green_count++; break;
+         case 0xff000000u: clear_count++; break;
+         default: other_count++; break;
+         }
+      }
+   }
+   uint32_t left_px =
+      *(const uint32_t *)(map + sub_layout.offset +
+                          32 * sub_layout.rowPitch + 16 * 4);
+   uint32_t right_px =
+      *(const uint32_t *)(map + sub_layout.offset +
+                          32 * sub_layout.rowPitch + 48 * 4);
+   uint32_t corner =
+      *(const uint32_t *)(map + sub_layout.offset +
+                          2 * sub_layout.rowPitch + 2 * 4);
+   vkUnmapMemory(device, color_mem);
+
+   if (getenv("TU5_DEPTH_DUMP")) {
+      void *dmap;
+      if (vkMapMemory(device, depth_mem, 0, VK_WHOLE_SIZE, 0, &dmap) == VK_SUCCESS) {
+         const uint32_t *p = dmap;
+         unsigned n = depth_req.size / 4;
+         unsigned ff = 0, a5 = 0, z25 = 0, z75 = 0, other = 0;
+         for (unsigned i = 0; i < n; i++) {
+            switch (p[i]) {
+            case 0x00ffffffu: ff++; break;
+            case 0xa5a5a5a5u: a5++; break;
+            case 0x00400000u: z25++; break;
+            case 0x00c00000u: z75++; break;
+            default: other++; break;
+            }
+         }
+         printf("depth dwords=%u ff=%u a5=%u z25=%u z75=%u other=%u\n",
+                n, ff, a5, z25, z75, other);
+         printf("depth[0..7]:");
+         for (unsigned i = 0; i < 8; i++)
+            printf(" %08x", p[i]);
+         printf("\n");
+         vkUnmapMemory(device, depth_mem);
+      }
+   }
+
+   printf("left=0x%08x right=0x%08x corner=0x%08x\n",
+          left_px, right_px, corner);
+   printf("red=%u blue=%u green=%u clear=%u other=%u\n",
+          red_count, blue_count, green_count, clear_count, other_count);
+
+   if (left_px != 0xff0000ffu) {
+      fprintf(stderr, "FAIL: stencil EQUAL ref=0 draw was not rejected\n");
+      return 1;
+   }
+   if (right_px != 0xff00ff00u) {
+      fprintf(stderr, "FAIL: stencil EQUAL ref=1 draw did not pass\n");
+      return 1;
+   }
+   if (corner != 0xff0000ffu) {
+      fprintf(stderr, "FAIL: corner should be red, got 0x%08x\n", corner);
+      return 1;
+   }
+   if (blue_count || clear_count || other_count) {
+      fprintf(stderr, "FAIL: unexpected pixels\n");
+      return 1;
+   }
+   if (green_count < 100 || red_count != 4096 - green_count) {
+      fprintf(stderr, "FAIL: unexpected coverage\n");
+      return 1;
+   }
+
+   printf("PASS\n");
+   return 0;
+}
diff --git a/a5xx/tests/tu5_test.c b/a5xx/tests/tu5_test.c
new file mode 100644
index 0000000..a0ef935
--- /dev/null
+++ b/a5xx/tests/tu5_test.c
@@ -0,0 +1,354 @@
+/*
+ * Minimal Vulkan compute smoke test for the a5xx Turnip MVP.
+ *
+ * One storage buffer at (set=0, binding=0), direct dispatch, host readback.
+ * Deliberately uses no extensions, no push constants and no graphics.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <vulkan/vulkan.h>
+
+#include "ssbo_spv.h"
+
+#define CHECK(x)                                                          \
+   do {                                                                   \
+      VkResult r_ = (x);                                                  \
+      if (r_ != VK_SUCCESS) {                                             \
+         fprintf(stderr, "%s:%d: %s -> %d\n", __FILE__, __LINE__, #x, r_);\
+         exit(1);                                                         \
+      }                                                                   \
+   } while (0)
+
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
+
+#define WG_SIZE     64u
+#define WG_COUNT    8u
+#define NUM_UINTS   (WG_SIZE * WG_COUNT)
+
+static uint32_t
+find_compute_queue(VkPhysicalDevice phys)
+{
+   uint32_t count = 0;
+   vkGetPhysicalDeviceQueueFamilyProperties(phys, &count, NULL);
+   VkQueueFamilyProperties *props = calloc(count, sizeof(*props));
+   vkGetPhysicalDeviceQueueFamilyProperties(phys, &count, props);
+
+   uint32_t result = UINT32_MAX;
+   for (uint32_t i = 0; i < count; i++) {
+      if (props[i].queueFlags & VK_QUEUE_COMPUTE_BIT) {
+         result = i;
+         break;
+      }
+   }
+
+   free(props);
+   return result;
+}
+
+int
+main(int argc, char **argv)
+{
+   const int use_indirect = argc > 1 && strcmp(argv[1], "indirect") == 0;
+   VkApplicationInfo app = {
+      .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+      .pApplicationName = "tu5-compute-smoke",
+      .apiVersion = VK_API_VERSION_1_0,
+   };
+   VkInstanceCreateInfo inst_info = {
+      .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+      .pApplicationInfo = &app,
+   };
+   VkInstance instance;
+   CHECK(vkCreateInstance(&inst_info, NULL, &instance));
+
+   uint32_t phys_count = 0;
+   CHECK(vkEnumeratePhysicalDevices(instance, &phys_count, NULL));
+   if (!phys_count) {
+      fprintf(stderr, "no Vulkan physical devices\n");
+      return 1;
+   }
+
+   VkPhysicalDevice *phys = calloc(phys_count, sizeof(*phys));
+   CHECK(vkEnumeratePhysicalDevices(instance, &phys_count, phys));
+
+   VkPhysicalDeviceProperties props;
+   vkGetPhysicalDeviceProperties(phys[0], &props);
+   printf("device: %s (api %u.%u.%u)\n", props.deviceName,
+          VK_VERSION_MAJOR(props.apiVersion),
+          VK_VERSION_MINOR(props.apiVersion),
+          VK_VERSION_PATCH(props.apiVersion));
+   printf("maxComputeWorkGroupInvocations: %u\n",
+          props.limits.maxComputeWorkGroupInvocations);
+
+   uint32_t queue_family = find_compute_queue(phys[0]);
+   if (queue_family == UINT32_MAX) {
+      fprintf(stderr, "no compute queue family\n");
+      return 1;
+   }
+
+   float priority = 1.0f;
+   VkDeviceQueueCreateInfo queue_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+      .queueFamilyIndex = queue_family,
+      .queueCount = 1,
+      .pQueuePriorities = &priority,
+   };
+   VkDeviceCreateInfo dev_info = {
+      .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+      .queueCreateInfoCount = 1,
+      .pQueueCreateInfos = &queue_info,
+   };
+   VkDevice device;
+   CHECK(vkCreateDevice(phys[0], &dev_info, NULL, &device));
+
+   VkQueue queue;
+   vkGetDeviceQueue(device, queue_family, 0, &queue);
+
+   const VkDeviceSize buf_size = NUM_UINTS * sizeof(uint32_t);
+   VkBufferCreateInfo buf_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = buf_size,
+      .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkBuffer buffer;
+   CHECK(vkCreateBuffer(device, &buf_info, NULL, &buffer));
+
+   VkMemoryRequirements mem_req;
+   vkGetBufferMemoryRequirements(device, buffer, &mem_req);
+
+   VkPhysicalDeviceMemoryProperties mem_props;
+   vkGetPhysicalDeviceMemoryProperties(phys[0], &mem_props);
+
+   uint32_t mem_type = UINT32_MAX;
+   for (uint32_t i = 0; i < mem_props.memoryTypeCount; i++) {
+      if ((mem_req.memoryTypeBits & (1u << i)) &&
+          (mem_props.memoryTypes[i].propertyFlags &
+           (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+            VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) ==
+             (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+              VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+         mem_type = i;
+         break;
+      }
+   }
+   if (mem_type == UINT32_MAX) {
+      fprintf(stderr, "no host-visible coherent memory type\n");
+      return 1;
+   }
+
+   VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = mem_req.size,
+      .memoryTypeIndex = mem_type,
+   };
+   VkDeviceMemory memory;
+   CHECK(vkAllocateMemory(device, &alloc_info, NULL, &memory));
+   CHECK(vkBindBufferMemory(device, buffer, memory, 0));
+
+   uint32_t *host = NULL;
+   CHECK(vkMapMemory(device, memory, 0, buf_size, 0, (void **)&host));
+   memset(host, 0, buf_size);
+
+   VkDescriptorSetLayoutBinding binding = {
+      .binding = 0,
+      .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+      .descriptorCount = 1,
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+   };
+   VkDescriptorSetLayoutCreateInfo dsl_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 1,
+      .pBindings = &binding,
+   };
+   VkDescriptorSetLayout dsl;
+   CHECK(vkCreateDescriptorSetLayout(device, &dsl_info, NULL, &dsl));
+
+   VkPushConstantRange pc_range = {
+      .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT,
+      .offset = 0,
+      .size = sizeof(uint32_t),
+   };
+   VkPipelineLayoutCreateInfo pl_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = 1,
+      .pSetLayouts = &dsl,
+      .pushConstantRangeCount = 1,
+      .pPushConstantRanges = &pc_range,
+   };
+   VkPipelineLayout pl;
+   CHECK(vkCreatePipelineLayout(device, &pl_info, NULL, &pl));
+
+   VkShaderModuleCreateInfo sm_info = {
+      .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+      .codeSize = sizeof(ssbo_spv),
+      .pCode = ssbo_spv,
+   };
+   VkShaderModule sm;
+   CHECK(vkCreateShaderModule(device, &sm_info, NULL, &sm));
+
+   VkComputePipelineCreateInfo cp_info = {
+      .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+      .stage = {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+         .module = sm,
+         .pName = "main",
+      },
+      .layout = pl,
+   };
+   VkPipeline pipeline;
+   CHECK(vkCreateComputePipelines(device, VK_NULL_HANDLE, 1, &cp_info,
+                                  NULL, &pipeline));
+
+   VkDescriptorPoolSize pool_size = {
+      .type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+      .descriptorCount = 1,
+   };
+   VkDescriptorPoolCreateInfo dp_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = 1,
+      .poolSizeCount = 1,
+      .pPoolSizes = &pool_size,
+   };
+   VkDescriptorPool dp;
+   CHECK(vkCreateDescriptorPool(device, &dp_info, NULL, &dp));
+
+   VkDescriptorSetAllocateInfo dsa_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = dp,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &dsl,
+   };
+   VkDescriptorSet ds;
+   CHECK(vkAllocateDescriptorSets(device, &dsa_info, &ds));
+
+   VkDescriptorBufferInfo dbi = {
+      .buffer = buffer,
+      .offset = 0,
+      .range = buf_size,
+   };
+   VkWriteDescriptorSet write = {
+      .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+      .dstSet = ds,
+      .dstBinding = 0,
+      .descriptorCount = 1,
+      .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,
+      .pBufferInfo = &dbi,
+   };
+   vkUpdateDescriptorSets(device, 1, &write, 0, NULL);
+
+   VkCommandPoolCreateInfo cpool_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+      .queueFamilyIndex = queue_family,
+   };
+   VkCommandPool cpool;
+   CHECK(vkCreateCommandPool(device, &cpool_info, NULL, &cpool));
+
+   VkCommandBufferAllocateInfo cb_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+      .commandPool = cpool,
+      .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+      .commandBufferCount = 1,
+   };
+   VkCommandBuffer cb;
+   CHECK(vkAllocateCommandBuffers(device, &cb_info, &cb));
+
+   VkBuffer indirect_buf = VK_NULL_HANDLE;
+   VkDeviceMemory indirect_mem = VK_NULL_HANDLE;
+
+   if (use_indirect) {
+      VkBufferCreateInfo ib_info = {
+         .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+         .size = 3 * sizeof(uint32_t),
+         .usage = VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT,
+         .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      };
+      CHECK(vkCreateBuffer(device, &ib_info, NULL, &indirect_buf));
+
+      VkMemoryRequirements ib_req;
+      vkGetBufferMemoryRequirements(device, indirect_buf, &ib_req);
+      VkMemoryAllocateInfo ib_alloc = {
+         .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+         .allocationSize = ib_req.size,
+         .memoryTypeIndex = mem_type,
+      };
+      CHECK(vkAllocateMemory(device, &ib_alloc, NULL, &indirect_mem));
+      CHECK(vkBindBufferMemory(device, indirect_buf, indirect_mem, 0));
+
+      uint32_t *groups;
+      CHECK(vkMapMemory(device, indirect_mem, 0, ib_req.size, 0,
+                        (void **)&groups));
+      groups[0] = WG_COUNT;
+      groups[1] = 1;
+      groups[2] = 1;
+      vkUnmapMemory(device, indirect_mem);
+   }
+
+   VkCommandBufferBeginInfo begin_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   CHECK(vkBeginCommandBuffer(cb, &begin_info));
+   vkCmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+   vkCmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, pl, 0, 1, &ds,
+                           0, NULL);
+   uint32_t add = 1;
+   vkCmdPushConstants(cb, pl, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(add),
+                      &add);
+   if (use_indirect)
+      vkCmdDispatchIndirect(cb, indirect_buf, 0);
+   else
+      vkCmdDispatch(cb, WG_COUNT, 1, 1);
+   CHECK(vkEndCommandBuffer(cb));
+
+   VkFenceCreateInfo fence_info = {
+      .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+   };
+   VkFence fence;
+   CHECK(vkCreateFence(device, &fence_info, NULL, &fence));
+
+   VkSubmitInfo submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &cb,
+   };
+   CHECK(vkQueueSubmit(queue, 1, &submit, fence));
+   CHECK(vkWaitForFences(device, 1, &fence, VK_TRUE, 5000000000ull));
+
+   unsigned errors = 0;
+   for (uint32_t i = 0; i < NUM_UINTS; i++) {
+      uint32_t expected = i * 3u + 1u;
+      if (host[i] != expected) {
+         if (errors < 8)
+            fprintf(stderr, "mismatch at %u: got 0x%08x, expected 0x%08x\n",
+                    i, host[i], expected);
+         errors++;
+      }
+   }
+
+   printf("debug: host[0]=0x%08x host[1]=0x%08x host[511]=0x%08x\n", host[0], host[1], host[511]);
+   printf("%s: %u/%u values correct\n", errors ? "FAIL" : "PASS",
+          NUM_UINTS - errors, NUM_UINTS);
+
+   vkUnmapMemory(device, memory);
+   vkDestroyFence(device, fence, NULL);
+   if (use_indirect) {
+      vkDestroyBuffer(device, indirect_buf, NULL);
+      vkFreeMemory(device, indirect_mem, NULL);
+   }
+   vkDestroyCommandPool(device, cpool, NULL);
+   vkDestroyDescriptorPool(device, dp, NULL);
+   vkDestroyShaderModule(device, sm, NULL);
+   vkDestroyPipeline(device, pipeline, NULL);
+   vkDestroyPipelineLayout(device, pl, NULL);
+   vkDestroyDescriptorSetLayout(device, dsl, NULL);
+   vkDestroyBuffer(device, buffer, NULL);
+   vkFreeMemory(device, memory, NULL);
+   vkDestroyDevice(device, NULL);
+   vkDestroyInstance(instance, NULL);
+
+   return errors ? 1 : 0;
+}
