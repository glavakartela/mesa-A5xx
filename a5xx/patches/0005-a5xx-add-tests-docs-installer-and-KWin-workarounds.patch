+   printf("graphics pipeline created\n");
+   if (argc > 1 && strcmp(argv[1], "pipeline") == 0) {
+      printf("pipeline-only: OK\n");
+      return 0;
+   }
+
+   VkCommandPoolCreateInfo pool_info = {
