From afc436e62d2740f189af6a2db0093c745a17bb1b Mon Sep 17 00:00:00 2001
From: Kulesha Evgeniy <voovdop@gmail.com>
Date: Fri, 20 Nov 2026 16:46:56 +0200
Subject: [PATCH 27/29] turnip/a5xx: implement vkCmdBindIndexBuffer

The core 1.0 entrypoint had no implementation (weak stub), so
vkCmdBindIndexBuffer never updated the index buffer state. Add a
wrapper that forwards to tu_CmdBindIndexBuffer2KHR for all gens.
---
 src/freedreno/vulkan/tu5_graphics.cc  |  5 +++++
 src/freedreno/vulkan/tu_cmd_buffer.cc | 15 +++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/src/freedreno/vulkan/tu5_graphics.cc b/src/freedreno/vulkan/tu5_graphics.cc
index 48e571a..7c138d0 100644
--- a/src/freedreno/vulkan/tu5_graphics.cc
+++ b/src/freedreno/vulkan/tu5_graphics.cc
@@ -2102,6 +2102,11 @@ tu5_draw(struct tu_cmd_buffer *cmd, const struct tu5_draw_info *info)
                         CP_DRAW_INDX_OFFSET_0_VIS_CULL(vismode);
 
    if (info->indexed) {
+      if (getenv("TU5_GFX_DEBUG"))
+         fprintf(stderr, "tu5: indexed draw count=%u first=%u voff=%d inst=%u va=%" PRIx64 " max=%u size=%u\n",
+                 info->index_count, info->first_index, info->vertex_offset,
+                 info->instance_count, cmd->state.index_va,
+                 cmd->state.max_index_count, cmd->state.index_size);
       enum a4xx_index_size index_size;
       switch (cmd->state.index_size) {
       case 1: index_size = INDEX4_SIZE_8_BIT; break;
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 1b3076c..d83db1b 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -4777,6 +4777,21 @@ tu_CmdBindIndexBuffer2KHR(VkCommandBuffer commandBuffer,
 }
 TU_GENX(tu_CmdBindIndexBuffer2KHR);
 
+/* vkCmdBindIndexBuffer is a core 1.0 entrypoint but the driver only has the
+ * 2KHR variant. Without this wrapper the generated weak symbol is a no-op
+ * and indexed draws read address 0. */
+template <chip CHIP>
+VKAPI_ATTR void VKAPI_CALL
+tu_CmdBindIndexBuffer(VkCommandBuffer commandBuffer,
+                      VkBuffer buffer,
+                      VkDeviceSize offset,
+                      VkIndexType indexType)
+{
+   tu_CmdBindIndexBuffer2KHR<CHIP>(commandBuffer, buffer, offset,
+                                   VK_WHOLE_SIZE, indexType);
+}
+TU_GENX(tu_CmdBindIndexBuffer);
+
 template <chip CHIP>
 static void
 tu6_emit_descriptor_sets(struct tu_cmd_buffer *cmd,
