       return lower_ssbo_ubo_intrinsic(dev, b, instr);
 
    case nir_intrinsic_image_deref_load:
@@ -1518,9 +1530,45 @@ shader_uses_push_consts(nir_shader *shader)
 }
 
 static bool
-tu5_lower_bindful_ssbo_instr(nir_builder *b, nir_intrinsic_instr *intrin,
-                             void *data)
+tu5_trace_desc_binding(nir_def *def, unsigned *binding)
 {
+   nir_instr *instr = nir_def_instr(def);
+
+   switch (instr->type) {
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      switch (intr->intrinsic) {
+      case nir_intrinsic_load_vulkan_descriptor:
+         return tu5_trace_desc_binding(intr->src[0].ssa, binding);
+      case nir_intrinsic_vulkan_resource_index:
+         *binding = nir_intrinsic_binding(intr);
+         return true;
+      case nir_intrinsic_vulkan_resource_reindex:
+         return tu5_trace_desc_binding(intr->src[0].ssa, binding);
+      default:
+         return false;
+      }
+   }
+   case nir_instr_type_alu: {
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++) {
+         if (tu5_trace_desc_binding(alu->src[i].src.ssa, binding))
+            return true;
+      }
+      return false;
+   }
+   default:
+      return false;
+   }
+}
+
+static bool
+tu5_lower_bindful_ssbo_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+
+   nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
    unsigned desc_src;
 
    switch (intrin->intrinsic) {
@@ -1540,13 +1588,12 @@ tu5_lower_bindful_ssbo_instr(nir_builder *b, nir_intrinsic_instr *intrin,
    if (intrin->src[desc_src].ssa->num_components == 1)
       return false;
 
-   /* The builder cursor is unset in instruction passes. */
-   nir_builder b_at = nir_builder_at(nir_before_instr(&intrin->instr));
+   unsigned binding;
+   if (!tu5_trace_desc_binding(intrin->src[desc_src].ssa, &binding))
+      return false;
 
-   /* MVP: only descriptor set 0, binding 0 is accepted for SSBOs, and the
-    * hardware slot equals the binding number.
-    */
-   nir_src_rewrite(&intrin->src[desc_src], nir_imm_int(&b_at, 0));
+   nir_builder b_at = nir_builder_at(nir_before_instr(instr));
+   nir_src_rewrite(&intrin->src[desc_src], nir_imm_int(&b_at, binding));
    return true;
 }
 
