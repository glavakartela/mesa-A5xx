From 80108bed360ea16d43256d8aa0b32149f9adcac8 Mon Sep 17 00:00:00 2001
From: local <local@local>
Date: Thu, 19 Nov 2026 22:58:19 +0200
Subject: [PATCH 11/29] turnip/a5xx: fix descriptor arrays in bindful SSBO path

nir_lower_amul needs num_ssbos to cover binding + array index, not just
the highest binding. Keep the full bindful slot count.

Descriptor array smoke test writes through array element 1 and passes
512/512 on Adreno 509.
---
 src/freedreno/vulkan/tu_shader.cc | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/vulkan/tu_shader.cc b/src/freedreno/vulkan/tu_shader.cc
index 92ac4a6..89eb7c4 100644
--- a/src/freedreno/vulkan/tu_shader.cc
+++ b/src/freedreno/vulkan/tu_shader.cc
@@ -236,8 +236,8 @@ tu_spirv_to_nir(struct tu_device *dev,
       uint32_t max_ubo = 0;
       nir_foreach_variable_with_modes (var, nir, nir_var_mem_ubo)
          max_ubo = MAX2(max_ubo, var->data.binding + 1);
-      nir->info.num_ubos = max_ubo;
-      nir->info.num_ssbos = max_ssbo;
+      nir->info.num_ubos = MAX2(max_ubo, (uint32_t)TU5_MAX_UBOS);
+      nir->info.num_ssbos = MAX2(max_ssbo, (uint32_t)TU5_MAX_SSBOS);
    } else {
       nir->info.num_ubos = 0;
       nir->info.num_ssbos = 0;
@@ -3919,7 +3919,7 @@ tu_shader_create(struct tu_device *dev,
       }
 
       if (has_ssbo)
-         nir->info.num_ssbos = max_binding + 1;
+         nir->info.num_ssbos = TU5_MAX_SSBOS;
    }
 
    if (dev->physical_device->info->chip == 5) {
