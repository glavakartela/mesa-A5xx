#version 450
/* Storage image load + store: reads the pixel at gl_GlobalInvocationID and
 * adds one to the red channel.  Exercises the coherent LDIB/STIB path and
 * the image-size constants used for byte offsets.
 */
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform image2D dst;

void main()
{
   ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
   vec4 p = imageLoad(dst, coord);
   imageStore(dst, coord, p + vec4(1.0 / 255.0, 0.0, 0.0, 0.0));
}
